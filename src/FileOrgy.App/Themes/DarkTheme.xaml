<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Graphite Carbon + Signal Teal Palette -->
    <SolidColorBrush x:Key="Brush.Shell" Color="#111317"/>
    <SolidColorBrush x:Key="Brush.Canvas" Color="#16191F"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1D212A"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#232834"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#262B38"/>
    <SolidColorBrush x:Key="Brush.Well" Color="#12151B"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#111317"/>

    <SolidColorBrush x:Key="Brush.Border" Color="#2A303C"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3B4354"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#232833"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A7B3"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E7583"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#052622"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#14B8A6"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0D9488"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#132F2D"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#1E5C56"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#5EEAD4"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#22C55E"/>
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#122B1E"/>
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#2D2211"/>
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FBBF24"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#2E1619"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#F87171"/>

    <SolidColorBrush x:Key="Brush.Info" Color="#38BDF8"/>
    <SolidColorBrush x:Key="Brush.InfoSubtle" Color="#132638"/>
    <SolidColorBrush x:Key="Brush.InfoText" Color="#7DD3FC"/>

    <SolidColorBrush x:Key="Brush.Selection" Color="#183836"/>
    <SolidColorBrush x:Key="Brush.RowAlternating" Color="#151820"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#1A1E26"/>
    <SolidColorBrush x:Key="Brush.TooltipBg" Color="#252A36"/>
    <SolidColorBrush x:Key="Brush.TooltipFg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Brush.ModalBackdrop" Color="#99090B0E"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#353C4A"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#4B5568"/>

</ResourceDictionary>
