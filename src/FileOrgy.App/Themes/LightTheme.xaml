<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm Alabaster + Deep Pine Teal Palette -->
    <SolidColorBrush x:Key="Brush.Shell" Color="#EFECE6"/>
    <SolidColorBrush x:Key="Brush.Canvas" Color="#F7F5F0"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#F4F2EC"/>
    <SolidColorBrush x:Key="Brush.Well" Color="#F1EFE9"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#EFECE6"/>

    <SolidColorBrush x:Key="Brush.Border" Color="#E2DFD7"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C9C3B8"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#EAE7DF"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#181A1F"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#525866"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#737986"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#0F766E"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#0D645D"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#115E59"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#DCF5F1"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#99DFD6"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#0F766E"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#15803D"/>
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#166534"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Brush.WarningText" Color="#92400E"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#991B1B"/>

    <SolidColorBrush x:Key="Brush.Info" Color="#0369A1"/>
    <SolidColorBrush x:Key="Brush.InfoSubtle" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="Brush.InfoText" Color="#075985"/>

    <SolidColorBrush x:Key="Brush.Selection" Color="#D1F2ED"/>
    <SolidColorBrush x:Key="Brush.RowAlternating" Color="#FAF8F4"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#ECE8DF"/>
    <SolidColorBrush x:Key="Brush.TooltipBg" Color="#181A1F"/>
    <SolidColorBrush x:Key="Brush.TooltipFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ModalBackdrop" Color="#66181A1F"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C9C3B8"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#A8A297"/>

</ResourceDictionary>
