<Window x:Class="FileOrgy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FileOrgy.App.Converters"
        xmlns:views="clr-namespace:FileOrgy.App.Views"
        mc:Ignorable="d"
        Title="FileOrgy — Real-Time Folder Automation &amp; Organization"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowState="Normal"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Shell}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.Name="FileOrgy Main Window">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
        <converters:ToastSeverityToBrushConverter x:Key="ToastSeverityToBrush"/>

        <Style x:Key="TabContentTransitionStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.88" To="1"
                                                 Duration="0:0:0.10">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="4" To="0"
                                                 Duration="0:0:0.10">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfirmationConfirmButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notifications.ActiveConfirmation.IsDestructive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            Background="{DynamicResource Brush.Shell}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: CUSTOM TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.TitleBar}"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="0,0,0,1"
                    AutomationProperties.AutomationId="TitleBar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand + Monitoring Pulse Pill -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Border Width="24" Height="24"
                                CornerRadius="{StaticResource Radius.Sm}"
                                Background="{DynamicResource Brush.Accent}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource Icon.LogoFolderBolt}"
                                  Fill="{DynamicResource Brush.TextOnAccent}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="FileOrgy"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Border Background="{DynamicResource Brush.Well}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="TitleBarMonitoringPill">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7"
                                         Fill="{Binding DashboardVM.IsMonitoring, Converter={StaticResource BoolToStatusBrush}}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DashboardVM.StatusText}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Window Controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="Toggle Dark / Light Theme"
                                AutomationProperties.AutomationId="TitleBarThemeToggleButton"
                                AutomationProperties.Name="Toggle Dark or Light Theme">
                            <Path Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Data" Value="{StaticResource Icon.Moon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Sun}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Click="OnMinimizeClick"
                                ToolTip="Minimize"
                                AutomationProperties.AutomationId="TitleBarMinimizeButton"
                                AutomationProperties.Name="Minimize Window">
                            <Path Data="{StaticResource Icon.Minimize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="MaximizeRestoreButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="OnMaximizeRestoreClick"
                                ToolTip="Maximize"
                                AutomationProperties.AutomationId="TitleBarMaximizeButton"
                                AutomationProperties.Name="Maximize Window">
                            <Path x:Name="MaximizeRestoreIcon"
                                  Data="{StaticResource Icon.Maximize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource CaptionCloseButtonStyle}"
                                Click="OnCloseClick"
                                ToolTip="Close"
                                AutomationProperties.AutomationId="TitleBarCloseButton"
                                AutomationProperties.Name="Close Window">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: NAVIGATION RAIL + WORKSPACE CANVAS -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION RAIL -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Shell}"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16,12,14"
                        AutomationProperties.AutomationId="NavigationRail">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="WORKSPACE"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="10,0,0,8"/>

                            <RadioButton Style="{StaticResource NavRailRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsDashboardTab, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="NavOverview"
                                         AutomationProperties.Name="Overview">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Overview}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsWatchFoldersTab, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="NavWatchFolders"
                                         AutomationProperties.Name="Watch Folders">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Watch Folders" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsRulesTab, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="NavRules"
                                         AutomationProperties.Name="Rules">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Workflow}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Rules" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsVariablesTab, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="NavVariables"
                                         AutomationProperties.Name="Variables and Lists">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Tag}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Variables &amp; Lists" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsLogsTab, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="NavLogs"
                                         AutomationProperties.Name="Logs">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.History}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Logs" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsSettingsTab, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="NavSettings"
                                         AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Settings}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Rail Footer Telemetry -->
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource Brush.Divider}"
                                BorderThickness="0,1,0,0"
                                Padding="6,12,6,0"
                                AutomationProperties.AutomationId="RailFooterTelemetry">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding DashboardVM.IsMonitoring, Converter={StaticResource BoolToStatusBrush}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DashboardVM.StatusText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ActiveWatchSummaryText}"
                                           Style="{StaticResource Text.Muted}"
                                           Margin="15,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <Grid Margin="15,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding MemoryUsageText}"
                                               Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SettingsVM.CurrentVersionText}"
                                               Style="{StaticResource Text.Caption}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT WORKSPACE CANVAS -->
                <Grid Grid.Column="1" Background="{DynamicResource Brush.Canvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Contextual Header -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="0,0,0,1"
                            Padding="24,18,24,14"
                            AutomationProperties.AutomationId="WorkspaceHeader">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding ActivePageTitle}"
                                           Style="{StaticResource Text.PageTitle}"
                                           AutomationProperties.AutomationId="ActivePageTitle"/>
                                <TextBlock Text="{Binding ActivePageSubtitle}"
                                           Style="{StaticResource Text.Secondary}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ScanMonitoredFoldersAsyncCommand}"
                                    ToolTip="Scan all active watch folders now (F5)"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="HeaderScanMonitoredButton"
                                    AutomationProperties.Name="Scan Monitored Folders">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Scan}"
                                          Fill="{DynamicResource Brush.TextOnAccent}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Scan Monitored Folders" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Startup Diagnostic Warning InfoBar -->
                    <Border Grid.Row="1"
                            Visibility="{Binding ShowGlobalStartupWarningBanner, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource Brush.WarningSubtle}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Padding="14,8"
                            Margin="24,10,24,0"
                            AutomationProperties.AutomationId="StartupWarningInfoBar"
                            AutomationProperties.Name="Startup Diagnostic Warning">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource Icon.Warning}"
                                  Fill="{DynamicResource Brush.WarningText}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,2,12,0"
                                  VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding StartupStatus.StatusTitle}"
                                           Style="{StaticResource Text.CardTitle}"
                                           Foreground="{DynamicResource Brush.WarningText}"/>
                                <TextBlock Text="{Binding StartupStatus.DiagnosticDetail}"
                                           Style="{StaticResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenStartupSettingsCommand}"
                                        Content="Inspect in Settings"
                                        Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="BannerInspectStartupButton"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RepairStartupFromBannerCommand}"
                                        Content="Repair Now"
                                        AutomationProperties.AutomationId="BannerRepairStartupButton"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pending Update InfoBar -->
                    <Border Grid.Row="2"
                            Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource Brush.AccentSubtle}"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Padding="14,8"
                            Margin="24,8,24,0"
                            AutomationProperties.AutomationId="PendingUpdateInfoBar"
                            AutomationProperties.Name="Pending Update Notification">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource Icon.Info}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Body}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0">
                                <Run Text="A new release of FileOrgy is available: "/>
                                <Run Text="{Binding PendingUpdateVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}"/>
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenPendingUpdateDialogCommand}"
                                        Content="View Update"
                                        Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="BannerViewUpdateButton"/>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DismissPendingUpdateNotificationCommand}"
                                        ToolTip="Dismiss update notice"
                                        AutomationProperties.AutomationId="BannerDismissUpdateButton"
                                        AutomationProperties.Name="Dismiss Update Notification">
                                    <Path Data="{StaticResource Icon.Close}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="11" Height="11"
                                          Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main View Host -->
                    <Grid Grid.Row="3">
                        <views:OverviewView DataContext="{Binding}"
                                            Style="{StaticResource TabContentTransitionStyle}"
                                            Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVis}}"/>

                        <views:WatchFoldersView DataContext="{Binding WatchFoldersVM}"
                                                Style="{StaticResource TabContentTransitionStyle}"
                                                Visibility="{Binding DataContext.IsWatchFoldersTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                        <views:RulesView DataContext="{Binding}"
                                         Style="{StaticResource TabContentTransitionStyle}"
                                         Visibility="{Binding IsRulesTab, Converter={StaticResource BoolToVis}}"/>

                        <views:VariablesView DataContext="{Binding VariablesVM}"
                                             Style="{StaticResource TabContentTransitionStyle}"
                                             Visibility="{Binding DataContext.IsVariablesTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                        <views:LogsView DataContext="{Binding LogsVM}"
                                        Style="{StaticResource TabContentTransitionStyle}"
                                        Visibility="{Binding DataContext.IsLogsTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                        <views:SettingsView DataContext="{Binding SettingsVM}"
                                            Style="{StaticResource TabContentTransitionStyle}"
                                            Visibility="{Binding DataContext.IsSettingsTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- OVERLAY 1: TOAST SNACKBARS -->
            <ItemsControl Grid.Row="0"
                          Grid.RowSpan="2"
                          ItemsSource="{Binding Notifications.Toasts}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="24"
                          Width="360"
                          Background="{x:Null}"
                          AutomationProperties.AutomationId="ToastOverlay">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Lg}"
                                Margin="0,8,0,0"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.32" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{Binding Severity, Converter={StaticResource ToastSeverityToBrush}}"
                                        CornerRadius="8,0,0,8"/>

                                <StackPanel Grid.Column="1" Margin="14,12,10,12">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock Text="{Binding Message}"
                                               Style="{StaticResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{Binding Id}"
                                        Click="OnDismissToastClick"
                                        VerticalAlignment="Top"
                                        Margin="0,8,8,0"
                                        ToolTip="Dismiss"
                                        AutomationProperties.Name="Dismiss Notification">
                                    <Path Data="{StaticResource Icon.Close}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="10" Height="10"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- OVERLAY 2: IN-APP MODAL CONFIRMATION SHEET -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="{Binding Notifications.HasActiveConfirmation, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource Brush.ModalBackdrop}"
                  AutomationProperties.AutomationId="ConfirmationModalOverlay"
                  AutomationProperties.Name="Confirmation Dialog">
                <Border Style="{StaticResource CardBorderStyle}"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                        MaxWidth="460"
                        MinWidth="380"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding Notifications.ActiveConfirmation.Title}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Notifications.ActiveConfirmation.Message}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,22"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Notifications.ActiveConfirmation.CancelLabel}"
                                    Click="OnCancelConfirmationClick"
                                    Margin="0,0,10,0"
                                    MinWidth="88"
                                    AutomationProperties.AutomationId="ModalCancelButton"
                                    AutomationProperties.Name="Cancel"/>
                            <Button Style="{StaticResource ConfirmationConfirmButtonStyle}"
                                    Content="{Binding Notifications.ActiveConfirmation.ConfirmLabel}"
                                    Click="OnConfirmConfirmationClick"
                                    MinWidth="96"
                                    AutomationProperties.AutomationId="ModalConfirmButton"
                                    AutomationProperties.Name="Confirm"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
