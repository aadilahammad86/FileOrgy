<UserControl x:Class="FileOrgy.App.Views.VariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FileOrgy.App.Converters"
             mc:Ignorable="d"
             x:Name="VariablesRoot"
             d:DesignHeight="720" d:DesignWidth="1080">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullInvertedToVis" Invert="True"/>
        <converters:CountToVisibilityConverter x:Key="CountZeroToVis" ShowWhenZero="True"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Custom Template Variables ({var:Key}) -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Custom Template Variables" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="Reference anywhere in rename patterns or destination paths as {var:Key}"
                                   Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Variables.Count}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.AccentText}"/>
                    </Border>
                </Grid>

                <!-- Quick Inline Creation Bar -->
                <Border Grid.Row="1" Style="{StaticResource WellBorderStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NewVariableKey, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Key (e.g. Vendor)"
                                 KeyDown="OnNewVariableKeyDown"
                                 AutomationProperties.AutomationId="Variables_NewKeyInput"
                                 AutomationProperties.Name="New Variable Name"/>

                        <TextBox Grid.Column="2"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12"
                                 Text="{Binding NewVariableValue, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Value (e.g. D:\Docs)"
                                 KeyDown="OnNewVariableKeyDown"
                                 AutomationProperties.AutomationId="Variables_NewValueInput"
                                 AutomationProperties.Name="New Variable Value"/>

                        <Button Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddVariableWithInputsCommand}"
                                AutomationProperties.AutomationId="Variables_AddVariableButton"
                                AutomationProperties.Name="Add Variable">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Plus}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Variable" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Variable Rows List -->
                <ListBox Grid.Row="2"
                         Style="{StaticResource CleanListBoxStyle}"
                         ItemsSource="{Binding Variables}"
                         SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                         AutomationProperties.AutomationId="Variables_List"
                         AutomationProperties.Name="Custom Template Variables List">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,9"
                                    AutomationProperties.AutomationId="{Binding Key}"
                                    AutomationProperties.Name="{Binding Key}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontWeight="SemiBold"
                                                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Variable key"
                                                 AutomationProperties.AutomationId="Variables_ItemKeyInput"
                                                 AutomationProperties.Name="Variable Key"/>

                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 FontSize="12"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Variable value"
                                                 AutomationProperties.AutomationId="Variables_ItemValueInput"
                                                 AutomationProperties.Name="Variable Value"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.CopyVariableTokenCommand, ElementName=VariablesRoot}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Copy token syntax to clipboard"
                                                    Margin="0,0,4,0"
                                                    AutomationProperties.AutomationId="Variables_CopyTokenButton"
                                                    AutomationProperties.Name="{Binding TokenSyntax}">
                                                <Path Data="{StaticResource Icon.Copy}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>

                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Foreground="{DynamicResource Brush.DangerText}"
                                                    Command="{Binding DataContext.RemoveVariableCommand, ElementName=VariablesRoot}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete variable"
                                                    AutomationProperties.AutomationId="Variables_DeleteVariableButton"
                                                    AutomationProperties.Name="Delete Variable">
                                                <Path Data="{StaticResource Icon.Trash}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="Token:"
                                                   Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <Border Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{Binding TokenSyntax}"
                                                       Style="{StaticResource Text.Mono}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="300"
                            Visibility="{Binding Variables.Count, Converter={StaticResource CountZeroToVis}}"
                            AutomationProperties.AutomationId="Variables_EmptyState">
                    <Border Width="44" Height="44"
                            CornerRadius="{StaticResource Radius.Lg}"
                            Background="{DynamicResource Brush.Well}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Path Data="{StaticResource Icon.Tag}"
                              Fill="{DynamicResource Brush.TextMuted}"
                              Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Custom Variables"
                               Style="{StaticResource Text.CardTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Add reusable paths or tags above to reference them across multiple rules."
                               Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT COLUMN: Reusable Keyword Lists -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reusable Keyword Lists" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="Match files or extracted text against named keyword groups in rule conditions"
                                   Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding KeywordLists.Count}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.AccentText}"/>
                    </Border>
                </Grid>

                <!-- Top Creation Bar -->
                <Border Grid.Row="1" Style="{StaticResource WellBorderStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NewKeywordListName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="New list name (e.g. Invoices)"
                                 KeyDown="OnNewKeywordListKeyDown"
                                 AutomationProperties.AutomationId="Variables_NewKeywordListInput"
                                 AutomationProperties.Name="New Keyword List Name"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddNamedKeywordListCommand}"
                                AutomationProperties.AutomationId="Variables_CreateKeywordListButton"
                                AutomationProperties.Name="Create Keyword List">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Plus}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Create List" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding RemoveKeywordListCommand}"
                                AutomationProperties.AutomationId="Variables_DeleteKeywordListButton"
                                AutomationProperties.Name="Delete Selected Keyword List">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Trash}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete List" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Nested Master-Detail: List Selector + Interactive Tag Chip Editor -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Keyword List Selector -->
                    <Border Grid.Column="0" Style="{StaticResource WellBorderStyle}" Padding="8">
                        <Grid>
                            <ListBox Style="{StaticResource CleanListBoxStyle}"
                                     ItemsSource="{Binding KeywordLists}"
                                     SelectedItem="{Binding SelectedKeywordList, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="Variables_KeywordListsSelector"
                                     AutomationProperties.Name="Keyword Lists Selector">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8"
                                                AutomationProperties.AutomationId="{Binding Name}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           Style="{StaticResource Text.CardTitle}"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Padding="7,2">
                                                    <TextBlock Text="{Binding ChipCount}"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.AccentText}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No keyword lists yet."
                                       Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Visibility="{Binding KeywordLists.Count, Converter={StaticResource CountZeroToVis}}"
                                       AutomationProperties.AutomationId="Variables_KeywordListsEmptyState"/>
                        </Grid>
                    </Border>

                    <!-- Interactive Tag Chip Editor -->
                    <Grid Grid.Column="2">
                        <!-- Placeholder when no list selected -->
                        <Border Style="{StaticResource WellBorderStyle}"
                                Visibility="{Binding SelectedKeywordList, Converter={StaticResource NullInvertedToVis}}"
                                AutomationProperties.AutomationId="Variables_NoKeywordListSelected">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260">
                                <Path Data="{StaticResource Icon.Tag}"
                                      Fill="{DynamicResource Brush.TextMuted}"
                                      Width="22" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Select a Keyword List"
                                           Style="{StaticResource Text.CardTitle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Create or select a keyword list on the left to manage its match chips."
                                           Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Keyword List Editor -->
                        <Border x:Name="KeywordListEditor"
                                Style="{StaticResource WellBorderStyle}"
                                DataContext="{Binding SelectedKeywordList}"
                                Visibility="{Binding DataContext.SelectedKeywordList, ElementName=VariablesRoot, Converter={StaticResource NullToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Editable List Name -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="List Name" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             FontWeight="SemiBold"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Keyword list name"
                                             AutomationProperties.AutomationId="Variables_SelectedListNameInput"
                                             AutomationProperties.Name="Selected Keyword List Name"/>
                                </StackPanel>

                                <!-- Add Keyword Input -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="NewKeywordInputBox"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding NewKeywordInput, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Add keywords (comma-separated)..."
                                             KeyDown="OnNewKeywordInputKeyDown"
                                             AutomationProperties.AutomationId="Variables_NewKeywordChipInput"
                                             AutomationProperties.Name="Add Keywords"/>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddKeywordChipCommand}"
                                            AutomationProperties.AutomationId="Variables_AddKeywordChipButton"
                                            AutomationProperties.Name="Add Keyword">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Plus}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Chips WrapPanel -->
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding KeywordChips}"
                                                      AutomationProperties.AutomationId="Variables_KeywordChipsList"
                                                      AutomationProperties.Name="Keyword Chips">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Brush.AccentSubtle}"
                                                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource Radius.Pill}"
                                                            Padding="10,4,6,4"
                                                            Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding}"
                                                                       FontFamily="{StaticResource Font.UI}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource Brush.AccentText}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <Button Style="{StaticResource IconButtonStyle}"
                                                                    MinWidth="20" MinHeight="20"
                                                                    Padding="3"
                                                                    Foreground="{DynamicResource Brush.AccentText}"
                                                                    Command="{Binding DataContext.RemoveKeywordChipCommand, ElementName=KeywordListEditor}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Remove keyword"
                                                                    AutomationProperties.AutomationId="Variables_RemoveKeywordChipButton"
                                                                    AutomationProperties.Name="{Binding}">
                                                                <Path Data="{StaticResource Icon.Close}"
                                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      Width="9" Height="9" Stretch="Uniform"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="No keywords in this list yet. Type one or more comma-separated terms above and press Enter."
                                                   Style="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ChipCount, Converter={StaticResource CountZeroToVis}}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Collapsible Raw Comma-Separated Sync -->
                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <CheckBox x:Name="ShowRawKeywordsToggle"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Content="Raw comma-separated sync (bulk paste)"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="Variables_ToggleRawKeywordsCheckBox"
                                              AutomationProperties.Name="Toggle Raw Comma-Separated Keyword Editor"/>

                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Md}"
                                            Padding="8"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ShowRawKeywordsToggle, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Edit or paste comma-separated keywords (syncs with chips on blur)"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                     FontFamily="{StaticResource Font.Mono}"
                                                     FontSize="12"
                                                     MinHeight="68"
                                                     MaxHeight="120"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding KeywordsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Tag="invoice, receipt, billing, statement"
                                                     AutomationProperties.AutomationId="Variables_RawKeywordsTextBox"
                                                     AutomationProperties.Name="Raw Comma-Separated Keywords"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
