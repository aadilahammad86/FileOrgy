<UserControl x:Class="FileOrgy.App.Views.WatchFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FileOrgy.App.Converters"
             mc:Ignorable="d"
             x:Name="WatchFoldersRoot"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullInvertedToVis" Invert="True"/>
        <converters:CountToVisibilityConverter x:Key="CountZeroToVis" ShowWhenZero="True"/>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action & Quick-Add Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddFolderCommand}"
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="WatchFolders_AddFolderButton"
                            AutomationProperties.Name="Add Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.FolderAdd}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Add Folder..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Quick Add:"
                               Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0"/>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding QuickAddKnownFolderCommand}"
                            CommandParameter="Downloads"
                            Margin="0,0,6,0"
                            Padding="10,5"
                            MinHeight="30"
                            AutomationProperties.AutomationId="WatchFolders_QuickAddDownloadsButton"
                            AutomationProperties.Name="Quick Add Downloads Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.FolderAdd}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Downloads" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding QuickAddKnownFolderCommand}"
                            CommandParameter="Desktop"
                            Margin="0,0,6,0"
                            Padding="10,5"
                            MinHeight="30"
                            AutomationProperties.AutomationId="WatchFolders_QuickAddDesktopButton"
                            AutomationProperties.Name="Quick Add Desktop Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.FolderAdd}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Desktop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding QuickAddKnownFolderCommand}"
                            CommandParameter="Documents"
                            Margin="0,0,6,0"
                            Padding="10,5"
                            MinHeight="30"
                            AutomationProperties.AutomationId="WatchFolders_QuickAddDocumentsButton"
                            AutomationProperties.Name="Quick Add Documents Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.FolderAdd}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Documents" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding QuickAddKnownFolderCommand}"
                            CommandParameter="Pictures"
                            Padding="10,5"
                            MinHeight="30"
                            AutomationProperties.AutomationId="WatchFolders_QuickAddPicturesButton"
                            AutomationProperties.Name="Quick Add Pictures Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.FolderAdd}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Pictures" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ScanFolderCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="WatchFolders_ScanSelectedButton"
                            AutomationProperties.Name="Scan Selected Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Scan}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="Scan Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding RemoveFolderCommand}"
                            AutomationProperties.AutomationId="WatchFolders_RemoveSelectedButton"
                            AutomationProperties.Name="Remove Selected Folder">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Trash}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Split Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Rail: Monitored Folders List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monitored Folders" Style="{StaticResource Text.SectionTitle}"/>
                            <TextBlock Text="Select a folder to configure rules &amp; exclusions" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                            <TextBlock Text="{Binding Folders.Count}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.AccentText}"/>
                        </Border>
                    </Grid>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource CleanListBoxStyle}"
                             ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             AutomationProperties.AutomationId="WatchFolders_FolderList"
                             AutomationProperties.Name="Monitored Folders List">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        AutomationProperties.AutomationId="{Binding Id}"
                                        AutomationProperties.Name="{Binding DisplayName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="8" Height="8"
                                                 Fill="{Binding Enabled, Converter={StaticResource BoolToStatusBrush}}"
                                                 VerticalAlignment="Top"
                                                 Margin="0,6,10,0"/>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource Text.CardTitle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FolderPath}"
                                                       Style="{StaticResource Text.Muted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FolderPath}"
                                                       Margin="0,2,0,0"/>
                                            <Border Background="{DynamicResource Brush.WarningSubtle}"
                                                    BorderBrush="{DynamicResource Brush.Warning}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Sm}"
                                                    Padding="6,2"
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding FolderExistsOnDisk, Converter={StaticResource InverseBoolToVis}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.Warning}"
                                                          Fill="{DynamicResource Brush.WarningText}"
                                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Missing on disk"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.WarningText}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2"
                                                  Style="{StaticResource SwitchCheckBoxStyle}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Enable or disable real-time watching"
                                                  AutomationProperties.AutomationId="WatchFolders_ItemEnabledSwitch"
                                                  AutomationProperties.Name="Enable Real-Time Watching"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16"
                                Visibility="{Binding Folders.Count, Converter={StaticResource CountZeroToVis}}"
                                AutomationProperties.AutomationId="WatchFolders_EmptyState">
                        <Border Width="44" Height="44"
                                CornerRadius="{StaticResource Radius.Lg}"
                                Background="{DynamicResource Brush.Well}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Path Data="{StaticResource Icon.Folder}"
                                  Fill="{DynamicResource Brush.TextMuted}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No Monitored Folders"
                                   Style="{StaticResource Text.CardTitle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Use Add Folder or a Quick Add preset above to begin monitoring a directory."
                                   Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Configuration Workspace -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <!-- Empty Selection Placeholder -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="360"
                                Visibility="{Binding SelectedFolder, Converter={StaticResource NullInvertedToVis}}"
                                AutomationProperties.AutomationId="WatchFolders_NoSelectionPlaceholder">
                        <Border Width="48" Height="48"
                                CornerRadius="{StaticResource Radius.Lg}"
                                Background="{DynamicResource Brush.Well}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Path Data="{StaticResource Icon.Folder}"
                                  Fill="{DynamicResource Brush.TextMuted}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Select a Monitored Folder"
                                   Style="{StaticResource Text.SectionTitle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Choose a folder from the left list to edit its path, debounce stabilization delay, and ignore patterns."
                                   Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Folder Configuration Workspace -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedFolder, Converter={StaticResource NullToVis}}">
                        <StackPanel x:Name="FolderDetailRoot"
                                    DataContext="{Binding SelectedFolder}"
                                    Margin="0,0,4,0">

                            <!-- Detail Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource Text.PageTitle}"
                                                   FontSize="19"/>
                                        <!-- Found Pill -->
                                        <Border Background="{DynamicResource Brush.SuccessSubtle}"
                                                BorderBrush="{DynamicResource Brush.Success}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Pill}"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding FolderExistsOnDisk, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Check}"
                                                      Fill="{DynamicResource Brush.SuccessText}"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Found on Disk"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.SuccessText}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Missing Pill -->
                                        <Border Background="{DynamicResource Brush.WarningSubtle}"
                                                BorderBrush="{DynamicResource Brush.Warning}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Pill}"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding FolderExistsOnDisk, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Warning}"
                                                      Fill="{DynamicResource Brush.WarningText}"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Missing on Disk"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.WarningText}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FolderPath}"
                                               Style="{StaticResource Text.Mono}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FolderPath}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenInExplorerCommand}"
                                            Margin="0,0,8,0"
                                            AutomationProperties.AutomationId="WatchFolders_OpenInExplorerButton"
                                            AutomationProperties.Name="Open in Explorer">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.ExternalLink}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Open in Explorer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.ScanFolderCommand, ElementName=WatchFoldersRoot}"
                                            AutomationProperties.AutomationId="WatchFolders_ScanNowButton"
                                            AutomationProperties.Name="Scan Folder Now">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Scan}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Scan Folder Now" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource Brush.Divider}" Height="1" Margin="0,0,0,16"/>

                            <!-- Editable Fields -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Display Name" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="e.g. Downloads Folder"
                                             AutomationProperties.AutomationId="WatchFolders_DisplayNameInput"
                                             AutomationProperties.Name="Folder Display Name"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Folder Path" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 FontSize="12"
                                                 Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="C:\Users\..."
                                                 AutomationProperties.AutomationId="WatchFolders_FolderPathInput"
                                                 AutomationProperties.Name="Folder Path"/>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding BrowseFolderPathCommand}"
                                                Content="Browse..."
                                                AutomationProperties.AutomationId="WatchFolders_BrowsePathButton"
                                                AutomationProperties.Name="Browse Folder Path"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Behavior Toggles -->
                            <Border Style="{StaticResource WellBorderStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource SwitchCheckBoxStyle}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Content="Enable Real-Time Watching"
                                              AutomationProperties.AutomationId="WatchFolders_EnableWatchingSwitch"
                                              AutomationProperties.Name="Enable Real-Time Watching"/>

                                    <CheckBox Grid.Column="2"
                                              Style="{StaticResource SwitchCheckBoxStyle}"
                                              IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}"
                                              Content="Include Subdirectories"
                                              AutomationProperties.AutomationId="WatchFolders_IncludeSubdirsSwitch"
                                              AutomationProperties.Name="Include Subdirectories"/>
                                </Grid>
                            </Border>

                            <!-- Debounce Stabilization Delay -->
                            <Border Style="{StaticResource WellBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Debounce Stabilization Delay" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Waits until file writes stop so browser downloads (.crdownload / .part) and large copies finish before rules run."
                                                       Style="{StaticResource Text.Muted}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                     Width="84"
                                                     FontFamily="{StaticResource Font.Mono}"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding DebounceDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="OnDebounceDelayKeyDown"
                                                     AutomationProperties.AutomationId="WatchFolders_DebounceInput"
                                                     AutomationProperties.Name="Debounce Delay in Milliseconds"/>
                                            <TextBlock Text="ms"
                                                       Style="{StaticResource Text.Muted}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Slider Minimum="100"
                                            Maximum="15000"
                                            SmallChange="100"
                                            LargeChange="500"
                                            TickFrequency="100"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding DebounceDelayMs, Mode=TwoWay}"
                                            AutomationProperties.AutomationId="WatchFolders_DebounceSlider"
                                            AutomationProperties.Name="Debounce Delay Slider"/>

                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="100 ms (instant)" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="15,000 ms (slider max; up to 60,000 ms via input)" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Interactive Ignore Patterns Chip Editor -->
                            <Border Style="{StaticResource WellBorderStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Ignore Patterns" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Files matching these wildcard globs are never processed in this folder."
                                                       Style="{StaticResource Text.Muted}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{Binding IgnorePatternsCollection.Count}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="IgnorePatternTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 FontSize="12"
                                                 Text="{Binding NewIgnorePattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="*.tmp, *.crdownload, ~*"
                                                 KeyDown="OnIgnorePatternKeyDown"
                                                 AutomationProperties.AutomationId="WatchFolders_IgnorePatternInput"
                                                 AutomationProperties.Name="New Ignore Pattern"/>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding AddIgnorePatternCommand}"
                                                AutomationProperties.AutomationId="WatchFolders_AddIgnorePatternButton"
                                                AutomationProperties.Name="Add Ignore Pattern">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Plus}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Add Pattern" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding IgnorePatternsCollection}"
                                                  AutomationProperties.AutomationId="WatchFolders_IgnorePatternsList"
                                                  AutomationProperties.Name="Ignore Patterns Chips">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Surface}"
                                                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Radius.Pill}"
                                                        Padding="10,4,6,4"
                                                        Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource Text.Mono}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource IconButtonStyle}"
                                                                MinWidth="20" MinHeight="20"
                                                                Padding="3"
                                                                Command="{Binding DataContext.RemoveIgnorePatternCommand, ElementName=FolderDetailRoot}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Remove ignore pattern"
                                                                AutomationProperties.AutomationId="WatchFolders_RemoveIgnorePatternButton"
                                                                AutomationProperties.Name="{Binding}">
                                                            <Path Data="{StaticResource Icon.Close}"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="9" Height="9" Stretch="Uniform"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No ignore patterns configured. All detected files will be evaluated."
                                               Style="{StaticResource Text.Muted}"
                                               Visibility="{Binding IgnorePatternsCollection.Count, Converter={StaticResource CountZeroToVis}}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
