<UserControl x:Class="FileOrgy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FileOrgy.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="920"
             AutomationProperties.AutomationId="SettingsView"
             AutomationProperties.Name="Settings Workspace">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:EnumFriendlyNameConverter x:Key="EnumFriendlyName"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,28">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <!-- CARD 1: HERO — WINDOWS STARTUP & TASK MANAGER DIAGNOSTICS -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="22"
                    Margin="0,0,0,16"
                    AutomationProperties.AutomationId="StartupDiagnosticsCard"
                    AutomationProperties.Name="Windows Startup and Task Manager Diagnostics">
                <StackPanel>

                    <!-- Header + Refresh + Repair -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Background="{DynamicResource Brush.AccentSubtle}"
                                    BorderBrush="{DynamicResource Brush.AccentBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <Path Data="{StaticResource Icon.Shield}"
                                      Fill="{DynamicResource Brush.AccentText}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows Startup &amp; Task Manager Diagnostics"
                                           Style="{StaticResource Text.SectionTitle}"/>
                                <TextBlock Text="Inspect how FileOrgy is registered with Windows and why Task Manager shows or hides it."
                                           Style="{StaticResource Text.Muted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshStartupStatusCommand}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="RefreshStartupStatusButton"
                                    AutomationProperties.Name="Refresh Startup Status">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Refresh}"
                                          Fill="{DynamicResource Brush.TextPrimary}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RepairStartupCommand}"
                                    AutomationProperties.AutomationId="RepairStartupHeaderButton"
                                    AutomationProperties.Name="Repair Startup Registration">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartupStatus.HasDiagnosticWarning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Repair Startup Registration"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status Diagnostic Banner -->
                    <Border CornerRadius="{StaticResource Radius.Md}"
                            BorderThickness="1"
                            Padding="16,14"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="StartupStatusBanner">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Well}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StartupStatus.HasDiagnosticWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Top"
                                  Margin="0,2,12,0">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Data" Value="{StaticResource Icon.Info}"/>
                                        <Setter Property="Fill" Value="{DynamicResource Brush.AccentText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartupStatus.HasDiagnosticWarning}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Warning}"/>
                                                <Setter Property="Fill" Value="{DynamicResource Brush.WarningText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding StartupStatus.StatusTitle}"
                                               Style="{StaticResource Text.CardTitle}"
                                               Margin="0,0,10,2"
                                               VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StartupStatus.Mode, Converter={StaticResource EnumFriendlyName}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.AccentText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding StartupStatus.DiagnosticDetail}"
                                           Style="{StaticResource Text.Secondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Visibility="{Binding StartupStatus.HasDiagnosticWarning, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RepairStartupCommand}"
                                    Content="Repair Now"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RepairStartupWarningButton"
                                    AutomationProperties.Name="Repair Startup Registration Now"/>
                        </Grid>
                    </Border>

                    <!-- Diagnostic Readout Grid -->
                    <Border Style="{StaticResource WellBorderStyle}"
                            Padding="16,14"
                            Margin="0,0,0,18"
                            AutomationProperties.AutomationId="StartupDiagnosticReadoutGrid">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Effective Mode" Style="{StaticResource Text.Muted}" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StartupStatus.Mode, Converter={StaticResource EnumFriendlyName}}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Windows User" Style="{StaticResource Text.Muted}" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartupStatus.CurrentWindowsUser}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Process Privilege" Style="{StaticResource Text.Muted}" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
                                        <Setter Property="Text" Value="Standard User"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartupStatus.IsCurrentProcessElevated}" Value="True">
                                                <Setter Property="Text" Value="Administrator (Elevated)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Task Manager Visibility" Style="{StaticResource Text.Muted}" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
                                        <Setter Property="Text" Value="Hidden from Task Manager -> Startup apps (Task Scheduler or disabled)"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartupStatus.VisibleInTaskManagerStartupApps}" Value="True">
                                                <Setter Property="Text" Value="Visible in Task Manager -> Startup apps (HKCU Run)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Scheduled Task Principal"
                                       Visibility="{Binding StartupStatus.ScheduledTaskPrincipal, Converter={StaticResource StringNotEmptyToVis}}"
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding StartupStatus.ScheduledTaskPrincipal}"
                                       Visibility="{Binding StartupStatus.ScheduledTaskPrincipal, Converter={StaticResource StringNotEmptyToVis}}"
                                       Style="{StaticResource Text.Mono}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Text="Registry Command"
                                       Visibility="{Binding StartupStatus.RegistryCommand, Converter={StaticResource StringNotEmptyToVis}}"
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding StartupStatus.RegistryCommand}"
                                       Visibility="{Binding StartupStatus.RegistryCommand, Converter={StaticResource StringNotEmptyToVis}}"
                                       Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Text="Task Scheduler Command"
                                       Visibility="{Binding StartupStatus.ScheduledTaskCommand, Converter={StaticResource StringNotEmptyToVis}}"
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       Text="{Binding StartupStatus.ScheduledTaskCommand}"
                                       Visibility="{Binding StartupStatus.ScheduledTaskCommand, Converter={StaticResource StringNotEmptyToVis}}"
                                       Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Startup Toggle Switches -->
                    <StackPanel Margin="0,0,0,14">
                        <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Content="Start FileOrgy automatically with Windows (starts in system tray)"
                                  AutomationProperties.AutomationId="StartWithWindowsSwitch"
                                  AutomationProperties.Name="Start with Windows"/>
                        <TextBlock Text="Uses HKCU\...\Run so FileOrgy appears in Task Manager -> Startup apps; Task Scheduler is used only when Elevated mode is enabled."
                                   Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="48,4,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                  IsChecked="{Binding RunAsAdmin, Mode=TwoWay}"
                                  Content="Run as Administrator on Startup (Elevated Task Scheduler mode)"
                                  AutomationProperties.AutomationId="RunAsAdminSwitch"
                                  AutomationProperties.Name="Run as Administrator on Startup"/>
                        <Border Style="{StaticResource WellBorderStyle}"
                                Padding="12,10"
                                Margin="48,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="{StaticResource Icon.Shield}"
                                          Fill="{DynamicResource Brush.InfoText}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,2,8,0"
                                          VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Windows Task Manager hides elevated Task Scheduler entries from the Startup Apps tab and binds scheduled tasks to a single Windows account. Keep this off unless your rules modify protected system folders."
                                               Style="{StaticResource Text.Secondary}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock Text="Notice: an existing scheduled task belongs to another Windows account or is inaccessible without elevation. Use Repair Startup Registration above to clean it up for your current user."
                                           Visibility="{Binding StartupStatus.IsScheduledTaskForeignOrInaccessible, Converter={StaticResource BoolToVis}}"
                                           Style="{StaticResource Text.Secondary}"
                                           Foreground="{DynamicResource Brush.WarningText}"
                                           TextWrapping="Wrap"
                                           Margin="21,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- CARD 2: APPEARANCE & THEME -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="22"
                    Margin="0,0,0,16"
                    AutomationProperties.AutomationId="AppearanceSettingsCard"
                    AutomationProperties.Name="Appearance and Behavior">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Behavior"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Switch between Dark and Light surfaces live across every screen and dialog."
                               Style="{StaticResource Text.Muted}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Theme Mode"
                               Style="{StaticResource Text.CardTitle}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dark Theme Option -->
                        <Border Grid.Column="0"
                                Style="{StaticResource WellBorderStyle}"
                                Padding="14,12">
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                         GroupName="ThemeModeGroup"
                                         IsChecked="{Binding DarkMode, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="ThemeDarkRadio"
                                         AutomationProperties.Name="Dark Theme Carbon Graphite">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Moon}"
                                          Fill="{DynamicResource Brush.AccentText}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Dark — Carbon Graphite" Style="{StaticResource Text.CardTitle}"/>
                                        <TextBlock Text="Low-glare slate surfaces with Signal Teal accents" Style="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Light Theme Option -->
                        <Border Grid.Column="2"
                                Style="{StaticResource WellBorderStyle}"
                                Padding="14,12">
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                         GroupName="ThemeModeGroup"
                                         IsChecked="{Binding DarkMode, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                                         AutomationProperties.AutomationId="ThemeLightRadio"
                                         AutomationProperties.Name="Light Theme Warm Alabaster">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Sun}"
                                          Fill="{DynamicResource Brush.WarningText}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Light — Warm Alabaster" Style="{StaticResource Text.CardTitle}"/>
                                        <TextBlock Text="Crisp daylight canvas with Deep Pine accents" Style="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>

                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                              IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                              Content="Minimize to System Tray when closing or minimizing the window"
                              Margin="0,0,0,12"
                              AutomationProperties.AutomationId="MinimizeToTraySwitch"
                              AutomationProperties.Name="Minimize to System Tray on Close"/>

                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                              IsChecked="{Binding ShowDesktopNotifications, Mode=TwoWay}"
                              Content="Show desktop tray balloon notifications for background file operations"
                              AutomationProperties.AutomationId="DesktopNotificationsSwitch"
                              AutomationProperties.Name="Show Desktop Notifications"/>
                </StackPanel>
            </Border>

            <!-- CARD 3: AUTOMATION ENGINE & MONITORING -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="22"
                    Margin="0,0,0,16"
                    AutomationProperties.AutomationId="AutomationEngineSettingsCard"
                    AutomationProperties.Name="Automation Engine and Monitoring">
                <StackPanel>
                    <TextBlock Text="Automation Engine &amp; Monitoring"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Tune watcher stability, background worker concurrency, and log retention."
                               Style="{StaticResource Text.Muted}"
                               Margin="0,0,0,16"/>

                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                              IsChecked="{Binding ScanOnStartup, Mode=TwoWay}"
                              Content="Automatically scan monitored folders when FileOrgy starts"
                              Margin="0,0,0,12"
                              AutomationProperties.AutomationId="ScanOnStartupSwitch"
                              AutomationProperties.Name="Scan Monitored Folders on Startup"/>

                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                              IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}"
                              Content="Automatically check for updates in the background"
                              Margin="0,0,0,18"
                              AutomationProperties.AutomationId="AutoCheckUpdatesSwitch"
                              AutomationProperties.Name="Auto Check for Updates"/>

                    <!-- Global Debounce Delay -->
                    <Border Style="{StaticResource WellBorderStyle}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Global Debounce Delay (ms)" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock Text="Waits before processing newly created files so downloads and copies finish cleanly."
                                               Style="{StaticResource Text.Muted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding GlobalDebounceDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="92"
                                             AutomationProperties.AutomationId="GlobalDebounceTextBox"
                                             AutomationProperties.Name="Global Debounce Delay Milliseconds"/>
                                    <TextBlock Text="ms" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider Minimum="100"
                                    Maximum="10000"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding GlobalDebounceDelayMs, Mode=TwoWay}"
                                    Margin="0,6,0,0"
                                    AutomationProperties.AutomationId="GlobalDebounceSlider"
                                    AutomationProperties.Name="Global Debounce Delay Slider"/>
                            <TextBlock Text="Slider range: 100 – 10,000 ms (manual input supported up to 60,000 ms)."
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Max Concurrent Operations -->
                    <Border Style="{StaticResource WellBorderStyle}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Max Concurrent Operations" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock Text="Limits simultaneous file pipelines to keep CPU and disk usage minimal."
                                               Style="{StaticResource Text.Muted}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}">
                                        <Run Text="{Binding MaxConcurrentOperations, Mode=OneWay}"/>
                                        <Run Text=" worker(s)"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <Slider Minimum="1"
                                    Maximum="8"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding MaxConcurrentOperations, Mode=TwoWay}"
                                    Margin="0,6,0,0"
                                    AutomationProperties.AutomationId="MaxConcurrentOperationsSlider"
                                    AutomationProperties.Name="Max Concurrent Operations"/>
                        </StackPanel>
                    </Border>

                    <!-- Log Retention Days -->
                    <Border Style="{StaticResource WellBorderStyle}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Log Retention Days" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="Automatically prunes audit log entries older than this threshold (1 – 3650 days)."
                                           Style="{StaticResource Text.Muted}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding LogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100"
                                         AutomationProperties.AutomationId="LogRetentionDaysTextBox"
                                         AutomationProperties.Name="Log Retention Days"/>
                                <TextBlock Text="days" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD 4: APPLICATION & UPDATES -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="22"
                    AutomationProperties.AutomationId="UpdatesSettingsCard"
                    AutomationProperties.Name="Application and Updates">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application &amp; Updates"
                                       Style="{StaticResource Text.SectionTitle}"/>
                            <TextBlock Text="Release verification and seamless in-app updates from GitHub Releases."
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                            <TextBlock Text="{Binding CurrentVersionText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.AccentText}"/>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource WellBorderStyle}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="UPDATE STATUS" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding UpdateStatusText}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenReleasesUrlCommand}"
                                        Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="ViewReleasesGitHubButton"
                                        AutomationProperties.Name="View Releases on GitHub">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.ExternalLink}"
                                              Fill="{DynamicResource Brush.TextPrimary}"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,7,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="View Releases on GitHub" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                        Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="CheckForUpdatesButton"
                                        AutomationProperties.Name="Check for Updates">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Refresh}"
                                              Fill="{DynamicResource Brush.TextPrimary}"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,7,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Check for Updates" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ShowUpdateDialogCommand}"
                                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Content="Install Update..."
                                        AutomationProperties.AutomationId="InstallUpdateButton"
                                        AutomationProperties.Name="Install Available Update"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
