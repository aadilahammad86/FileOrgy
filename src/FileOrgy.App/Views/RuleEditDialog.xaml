<Window x:Class="FileOrgy.App.Views.RuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FileOrgy.Core.Models;assembly=FileOrgy.Core"
        xmlns:converters="clr-namespace:FileOrgy.App.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Edit Automation Rule &amp; Workflow"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="#111827"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <ObjectDataProvider x:Key="RuleTargetValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RuleTarget"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ConditionOperatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ConditionOperator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StepTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StepType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ConflictResolutionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ConflictResolution"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="CaseTransformValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CaseTransform"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ArchiveDestValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ArchiveExtractDestination"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ArchivePostActionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ArchivePostAction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <converters:EnumFriendlyNameConverter x:Key="EnumFriendlyNameConverter"/>

        <Style x:Key="TokenChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#818CF8"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,5,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#312E81"/>
                    <Setter Property="Foreground" Value="#C7D2FE"/>
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#374151" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Configure Automation Rule" FontSize="18" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                    <TextBlock Text="Define matching conditions and the sequential multi-step workflow." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💡 Rule Guide &amp; Tutorial" Click="OnGuideClick" Padding="12,6" Background="#312E81" Foreground="#C7D2FE" BorderBrush="#4338CA" BorderThickness="1" Cursor="Hand" Margin="0,0,16,0" ToolTip="Open the interactive guide, rules explanation, and tokens cheatsheet">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <CheckBox Content="Rule Enabled" IsChecked="{Binding Enabled}" Foreground="#F9FAFB" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox Content="Stop on match" IsChecked="{Binding StopOnFirstMatch}" Foreground="#9CA3AF" VerticalAlignment="Center" ToolTip="If matched, stops lower priority rules from processing this file"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form: 2 Columns (Left: General & Conditions, Right: Workflow Steps) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Rule info & Conditions -->
            <Border Grid.Column="0" Background="#1F2937" CornerRadius="8" Padding="16" BorderBrush="#374151" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Rule Name -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Rule Name" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="8" FontSize="13"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="8" FontSize="13"/>
                    </StackPanel>

                    <!-- Match Logic Selection -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Match Logic" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Match ALL conditions (AND)" IsChecked="{Binding IsMatchAll}" Foreground="#F9FAFB" Margin="0,0,16,0"/>
                            <RadioButton Content="Match ANY condition (OR)" IsChecked="{Binding IsMatchAny}" Foreground="#F9FAFB"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Conditions Header -->
                    <Grid Grid.Row="3" Margin="0,8,0,8">
                        <TextBlock Text="Matching Conditions" FontSize="14" FontWeight="SemiBold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        <Button Content="+ Add Condition" Command="{Binding AddConditionCommand}" HorizontalAlignment="Right" Padding="10,4" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <!-- Conditions List -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111827" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#374151" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Target -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                                <TextBlock Text="Target" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource RuleTargetValues}}" SelectedItem="{Binding Target}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Operator -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,6,6">
                                                <TextBlock Text="Operator" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource ConditionOperatorValues}}" SelectedItem="{Binding Operator}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Remove Condition Button -->
                                            <Button Grid.Row="0" Grid.Column="2" Content="✕"
                                                    Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#EF4444" Foreground="White" Width="26" Height="26" VerticalAlignment="Bottom" Margin="0,0,0,6" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Remove condition">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Keyword List Selector (Shown when Operator is InKeywordList / NotInKeywordList) -->
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,6,0"
                                                        Visibility="{Binding IsKeywordListVisible, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Keyword List Name" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding AvailableKeywordLists}"
                                                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedItem="{Binding Value}"
                                                          IsEditable="True"/>
                                                <TextBlock Text="{Binding KeywordListPreview}" FontSize="11" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding KeywordListPreview}"/>
                                            </StackPanel>

                                            <!-- Value / Pattern Input (Shown for other operators) -->
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,6,0"
                                                        Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Value / Pattern / Expression" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Background="#1F2937" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6" FontSize="13"/>
                                            </StackPanel>

                                            <!-- Case Sensitivity Option -->
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                                        Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVis}}">
                                                <CheckBox Content="Case sensitive match" IsChecked="{Binding CaseSensitive}" Foreground="#9CA3AF" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Multi-Step Workflow Pipeline -->
            <Border Grid.Column="2" Background="#1F2937" CornerRadius="8" Padding="16" BorderBrush="#374151" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.4*"/>
                    </Grid.RowDefinitions>

                    <!-- Steps Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Workflow Execution Sequence" FontSize="14" FontWeight="SemiBold" Foreground="#F9FAFB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▲ Up" Command="{Binding MoveStepUpCommand}" Padding="8,4" Background="#374151" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" ToolTip="Move selected step earlier in sequence"/>
                            <Button Content="▼ Down" Command="{Binding MoveStepDownCommand}" Padding="8,4" Background="#374151" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" ToolTip="Move selected step later in sequence"/>
                            <Button Content="✕ Remove" Command="{Binding RemoveStepCommand}" CommandParameter="{Binding SelectedStep}" Padding="8,4" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Remove selected step"/>
                            <Button Content="+ Add Step" Command="{Binding AddStepCommand}" Padding="10,4" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Add a new workflow action step"/>
                        </StackPanel>
                    </Grid>

                    <!-- Steps List (Sequence) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Background="#111827" BorderBrush="#374151" Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="●" Foreground="#6366F1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                        <TextBlock Text="{Binding StepType, Converter={StaticResource EnumFriendlyNameConverter}}" FontSize="11" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Content="Active" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Step Configuration Title -->
                    <TextBlock Grid.Row="2" Text="Step Configuration Details" FontSize="13" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,8"/>

                    <!-- Step Details Configuration Area -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedStep}">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Step Type -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Step Type" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource StepTypeValues}}" SelectedItem="{Binding StepType}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Step Name" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <!-- Smart Rename Options -->
                            <StackPanel Visibility="{Binding IsRenameVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Rename Pattern" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding RenamePattern, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6" FontSize="13"/>
                                
                                <!-- Token Chips -->
                                <WrapPanel Margin="0,6,0,6">
                                    <TextBlock Text="Insert Token:" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <Button Content="{}{basename}" Style="{StaticResource TokenChipStyle}" ToolTip="Original file name without extension" Command="{Binding AppendTokenCommand}" CommandParameter="{}{basename}"/>
                                    <Button Content="{}{ext}" Style="{StaticResource TokenChipStyle}" ToolTip="File extension (without dot)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{ext}"/>
                                    <Button Content="{}{dotext}" Style="{StaticResource TokenChipStyle}" ToolTip="File extension (with dot e.g. .pdf)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{dotext}"/>
                                    <Button Content="{}{doc_date:yyyy-MM-dd}" Style="{StaticResource TokenChipStyle}" ToolTip="Extracted document/invoice date" Command="{Binding AppendTokenCommand}" CommandParameter="{}{doc_date:yyyy-MM-dd}"/>
                                    <Button Content="{}{year}" Style="{StaticResource TokenChipStyle}" ToolTip="Current year (e.g. 2026)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{year}"/>
                                    <Button Content="{}{month}" Style="{StaticResource TokenChipStyle}" ToolTip="Current month (01-12)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{month}"/>
                                    <Button Content="{}{counter:001}" Style="{StaticResource TokenChipStyle}" ToolTip="Incrementing counter (001, 002...)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{counter:001}"/>
                                </WrapPanel>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Case Transform" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource CaseTransformValues}}" SelectedItem="{Binding CaseTransform}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Conflict Resolution" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource ConflictResolutionValues}}" SelectedItem="{Binding ConflictResolution}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Move / Copy Options -->
                            <StackPanel Visibility="{Binding IsMoveOrCopyVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Destination Path" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding DestinationTemplate, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6" FontSize="13"/>
                                
                                <!-- Token Chips -->
                                <WrapPanel Margin="0,6,0,6">
                                    <TextBlock Text="Insert Path Token:" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <Button Content="{}{directory}" Style="{StaticResource TokenChipStyle}" ToolTip="Folder where the file was detected (e.g. Downloads)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{directory}"/>
                                    <Button Content="{}{doc_date:yyyy}" Style="{StaticResource TokenChipStyle}" ToolTip="Document invoice year" Command="{Binding AppendTokenCommand}" CommandParameter="{}{doc_date:yyyy}"/>
                                    <Button Content="{}{year}" Style="{StaticResource TokenChipStyle}" ToolTip="Current year (e.g. 2026)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{year}"/>
                                    <Button Content="{}{month}" Style="{StaticResource TokenChipStyle}" ToolTip="Current month (01-12)" Command="{Binding AppendTokenCommand}" CommandParameter="{}{month}"/>
                                    <Button Content="{}{basename}" Style="{StaticResource TokenChipStyle}" ToolTip="File name without extension" Command="{Binding AppendTokenCommand}" CommandParameter="{}{basename}"/>
                                </WrapPanel>

                                <StackPanel Margin="0,2,0,0">
                                    <TextBlock Text="Conflict Resolution" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource ConflictResolutionValues}}" SelectedItem="{Binding ConflictResolution}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Archive Extraction Options -->
                            <StackPanel Visibility="{Binding IsArchiveVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Extraction Destination" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ArchiveDestValues}}" SelectedItem="{Binding ExtractDestination}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="After Extraction Action" FontSize="11" Foreground="#9CA3AF" Margin="0,6,0,2"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ArchivePostActionValues}}" SelectedItem="{Binding ArchivePostAction}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Content="Automatically organize extracted files with pipeline" IsChecked="{Binding EnqueueExtractedFiles}" Foreground="#F9FAFB" Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Regex Capture Options -->
                            <StackPanel Visibility="{Binding IsRegexVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Regex Source (Content, FileName, FullPath)" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding RegexSource, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6"/>
                                <TextBlock Text="Regex Pattern (Use capture groups e.g. Invoice #?([A-Z0-9-]+))" FontSize="11" Foreground="#9CA3AF" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6"/>
                            </StackPanel>

                            <!-- Cleanup Options -->
                            <StackPanel Visibility="{Binding IsCleanupVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Remove Files Older Than (Days)" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding OlderThanDays, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6"/>
                                <CheckBox Content="Send to Windows Recycle Bin (Undoable)" IsChecked="{Binding SafeRecycle}" Foreground="#F9FAFB" Margin="0,6,0,0"/>
                                <CheckBox Content="Delete Empty Subdirectories" IsChecked="{Binding RemoveEmptyFolders}" Foreground="#F9FAFB" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Run Command Options -->
                            <StackPanel Visibility="{Binding IsCommandVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="Executable Path" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CommandExecutable, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6"/>
                                <TextBlock Text="Arguments" FontSize="11" Foreground="#9CA3AF" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding CommandArguments, UpdateSourceTrigger=PropertyChanged}" Background="#111827" Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="6"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Apply" Click="OnSaveClick" Background="#4F46E5" Foreground="White" FontWeight="SemiBold" Padding="18,8" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="Cancel" Click="OnCancelClick" Background="#374151" Foreground="#D1D5DB" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
