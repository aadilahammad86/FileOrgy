<Window x:Class="FileOrgy.App.Views.RuleEditDialog"
        x:Name="RuleDialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FileOrgy.Core.Models;assembly=FileOrgy.Core"
        xmlns:converters="clr-namespace:FileOrgy.App.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Edit Automation Rule &amp; Workflow"
        Height="760"
        Width="1140"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:CountToVisibilityConverter x:Key="CountToZeroVis" ShowWhenZero="True"/>
        <converters:EnumFriendlyNameConverter x:Key="EnumFriendlyNameConverter"/>
        <converters:StepTypeToIconKeyConverter x:Key="StepTypeToIconKeyConverter"/>

        <ObjectDataProvider x:Key="RuleTargetValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RuleTarget"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ConditionOperatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ConditionOperator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StepTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StepType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ConflictResolutionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ConflictResolution"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="CaseTransformValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CaseTransform"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ArchiveDestValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ArchiveExtractDestination"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ArchivePostActionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ArchivePostAction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <x:Array x:Key="RegexSourceOptions" Type="{x:Type sys:String}">
            <sys:String>Content</sys:String>
            <sys:String>FileName</sys:String>
            <sys:String>FullPath</sys:String>
        </x:Array>

        <Style x:Key="ScopePillToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.Well}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Canvas}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ZONE 0: Header, Metadata & Folder Scope -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Title & Switches Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.AccentSubtle}"
                                BorderBrush="{DynamicResource Brush.AccentBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                Width="36"
                                Height="36"
                                Margin="0,0,12,0">
                            <Path Data="{StaticResource Icon.Workflow}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Configure Automation Rule" Style="{StaticResource Text.SectionTitle}" FontSize="17"/>
                            <TextBlock Text="Define folder scope, matching conditions, and sequential workflow steps" Style="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnGuideClick"
                                Margin="0,0,16,0"
                                ToolTip="Open the Automation Rules &amp; Workflows Guide"
                                AutomationProperties.AutomationId="BtnOpenRuleGuide"
                                AutomationProperties.Name="Rule Guide">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Lightbulb}"
                                      Fill="{DynamicResource Brush.AccentText}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Rule Guide" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                  Content="Enabled"
                                  IsChecked="{Binding Enabled}"
                                  Margin="0,0,16,0"
                                  AutomationProperties.AutomationId="ChkRuleEnabled"
                                  AutomationProperties.Name="Rule Enabled"/>

                        <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                  Content="Stop on match"
                                  IsChecked="{Binding StopOnFirstMatch}"
                                  ToolTip="When enabled, lower priority rules will not evaluate this file after this rule matches"
                                  AutomationProperties.AutomationId="ChkStopOnFirstMatch"
                                  AutomationProperties.Name="Stop on First Match"/>
                    </StackPanel>
                </Grid>

                <!-- Metadata Inputs Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RULE NAME" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. Monthly Invoices"
                                 AutomationProperties.AutomationId="TxtRuleName"
                                 AutomationProperties.Name="Rule Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Optional note explaining what this rule organizes..."
                                 AutomationProperties.AutomationId="TxtRuleDescription"
                                 AutomationProperties.Name="Rule Description"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="PRIORITY" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="0"
                                 ToolTip="Lower numbers run earlier"
                                 AutomationProperties.AutomationId="TxtRulePriority"
                                 AutomationProperties.Name="Rule Priority"/>
                    </StackPanel>
                </Grid>

                <!-- Folder Scope Strip -->
                <Border Style="{StaticResource WellBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Path Data="{StaticResource Icon.Folder}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FolderScopeSummary}"
                                       Style="{StaticResource Text.Secondary}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Button Content="All Folders"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding ClearFolderScopeCommand}"
                                    Padding="8,3"
                                    MinHeight="26"
                                    FontSize="12"
                                    ToolTip="Clear folder selection so this rule applies to all monitored folders"
                                    AutomationProperties.AutomationId="BtnClearFolderScope"
                                    AutomationProperties.Name="Apply to All Folders"/>
                        </StackPanel>

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding FolderScopeChoices}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ScopePillToggleStyle}"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding FolderPath}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ZONES 1 & 2: Split 45% / 55% -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.45*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.55*"/>
            </Grid.ColumnDefinitions>

            <!-- ZONE 1 (Left 42%): Trigger & Match Conditions -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Add Condition -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Trigger &amp; Match Conditions"
                                   Style="{StaticResource Text.SectionTitle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddConditionCommand}"
                                Padding="11,6"
                                MinHeight="32"
                                AutomationProperties.AutomationId="BtnAddCondition"
                                AutomationProperties.Name="Add Condition">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}"
                                      Fill="{DynamicResource Brush.TextOnAccent}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Add Condition" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Segmented Match Logic Toggle -->
                    <Border Grid.Row="1" Style="{StaticResource WellBorderStyle}" Padding="6" Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                                         Content="Match ALL (AND)"
                                         IsChecked="{Binding IsMatchAll, Mode=TwoWay}"
                                         GroupName="RuleMatchLogicGroup"
                                         AutomationProperties.AutomationId="RadMatchAll"
                                         AutomationProperties.Name="Match ALL Conditions (AND)"/>
                            <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                                         Content="Match ANY (OR)"
                                         IsChecked="{Binding IsMatchAny, Mode=TwoWay}"
                                         GroupName="RuleMatchLogicGroup"
                                         AutomationProperties.AutomationId="RadMatchAny"
                                         AutomationProperties.Name="Match ANY Condition (OR)"/>
                        </UniformGrid>
                    </Border>

                    <!-- Conditions List -->
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Conditions}"
                                          AutomationProperties.AutomationId="ConditionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WellBorderStyle}" Padding="12" Margin="0,0,4,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Target -->
                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="TARGET" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource RuleTargetValues}}"
                                                              SelectedItem="{Binding Target, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Operator -->
                                                <StackPanel Grid.Row="0" Grid.Column="2">
                                                    <TextBlock Text="OPERATOR" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource ConditionOperatorValues}}"
                                                              SelectedItem="{Binding Operator, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Delete Condition -->
                                                <Button Grid.Row="0" Grid.Column="4"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding ElementName=RuleDialogRoot, Path=DataContext.RemoveConditionCommand}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Bottom"
                                                        ToolTip="Remove condition"
                                                        AutomationProperties.Name="Remove Condition">
                                                    <Path Data="{StaticResource Icon.Trash}"
                                                          Fill="{DynamicResource Brush.DangerText}"
                                                          Width="14"
                                                          Height="14"
                                                          Stretch="Uniform"/>
                                                </Button>

                                                <!-- Custom Variable Name (Visible when Target == CustomVariable) -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                                            Margin="0,8,0,0"
                                                            Visibility="{Binding IsCustomVariableVisible, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="CUSTOM VARIABLE NAME" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                             Text="{Binding TargetVariable, UpdateSourceTrigger=PropertyChanged}"
                                                             Tag="e.g. Vendor or match_1"/>
                                                </StackPanel>

                                                <!-- Keyword List Selector -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                                            Margin="0,8,0,0"
                                                            Visibility="{Binding IsKeywordListVisible, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="KEYWORD LIST" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding AvailableKeywordLists}"
                                                              SelectedItem="{Binding KeywordListName, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding KeywordListPreview}"
                                                               Style="{StaticResource Text.Muted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding KeywordListPreview}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Standard Value Input -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                                            Margin="0,8,0,0"
                                                            Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="VALUE / PATTERN" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Tag="Value, wildcard (*.pdf), or regex..."/>
                                                </StackPanel>

                                                <!-- Case Sensitive -->
                                                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          Content="Case sensitive"
                                                          IsChecked="{Binding CaseSensitive}"
                                                          Margin="0,8,0,0"
                                                          Visibility="{Binding IsValueVisible, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty Conditions Hint -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding Conditions.Count, Converter={StaticResource CountToZeroVis}}">
                            <TextBlock Text="No conditions added"
                                       Style="{StaticResource Text.CardTitle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Without conditions, this rule matches every file in scope."
                                       Style="{StaticResource Text.Muted}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="260"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ZONE 2 (Right 58%): Sequential Workflow Pipeline -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.85*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="1.35*"/>
                    </Grid.RowDefinitions>

                    <!-- Pipeline Header & Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Sequential Workflow Pipeline"
                                   Style="{StaticResource Text.SectionTitle}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding MoveStepUpCommand}"
                                    ToolTip="Move step up"
                                    Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="BtnMoveStepUp"
                                    AutomationProperties.Name="Move Step Up">
                                <Path Data="{StaticResource Icon.ChevronUp}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding MoveStepDownCommand}"
                                    ToolTip="Move step down"
                                    Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="BtnMoveStepDown"
                                    AutomationProperties.Name="Move Step Down">
                                <Path Data="{StaticResource Icon.ChevronDown}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding RemoveStepCommand}"
                                    CommandParameter="{Binding SelectedStep}"
                                    ToolTip="Delete selected step"
                                    Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="BtnDeleteStep"
                                    AutomationProperties.Name="Delete Selected Step">
                                <Path Data="{StaticResource Icon.Trash}"
                                      Fill="{DynamicResource Brush.DangerText}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddStepCommand}"
                                    Padding="11,6"
                                    MinHeight="32"
                                    AutomationProperties.AutomationId="BtnAddStep"
                                    AutomationProperties.Name="Add Step">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Plus}"
                                          Fill="{DynamicResource Brush.TextOnAccent}"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Step" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Ordered Step Chain -->
                    <Border Grid.Row="1" Style="{StaticResource WellBorderStyle}" Padding="8">
                        <Grid>
                            <ListBox Style="{StaticResource CleanListBoxStyle}"
                                     ItemsSource="{Binding Steps}"
                                     SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="RuleStepsList"
                                     AutomationProperties.Name="Workflow Steps">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Brush.Surface}"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Radius.Md}"
                                                        Width="30"
                                                        Height="30"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Path Data="{Binding StepType, Converter={StaticResource StepTypeToIconKeyConverter}}"
                                                          Fill="{DynamicResource Brush.AccentText}"
                                                          Width="14"
                                                          Height="14"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                                    <TextBlock Text="{Binding StepType, Converter={StaticResource EnumFriendlyNameConverter}}"
                                                               Style="{StaticResource Text.Muted}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource Brush.WarningSubtle}"
                                                            CornerRadius="{StaticResource Radius.Pill}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            Visibility="{Binding ContinueOnError, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Continue on error"
                                                                   Foreground="{DynamicResource Brush.WarningText}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>

                                                    <Border Background="{DynamicResource Brush.SuccessSubtle}"
                                                            CornerRadius="{StaticResource Radius.Pill}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Active"
                                                                   Foreground="{DynamicResource Brush.SuccessText}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>

                                                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                                              IsChecked="{Binding Enabled}"
                                                              ToolTip="Enable or disable this step"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Add one or more workflow steps to define what happens when this rule matches."
                                       Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Steps.Count, Converter={StaticResource CountToZeroVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Selected Step Configuration Inspector -->
                    <Border Grid.Row="3"
                            Style="{StaticResource WellBorderStyle}"
                            Padding="14"
                            Visibility="{Binding SelectedStep, Converter={StaticResource NullToVis}}"
                            AutomationProperties.AutomationId="StepInspectorPanel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding SelectedStep}">
                                <TextBlock Text="STEP CONFIGURATION" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>

                                <!-- Common Row: Name & StepType -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Step Name" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Step label"
                                                 AutomationProperties.AutomationId="TxtStepName"
                                                 AutomationProperties.Name="Step Name"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Action Type" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource StepTypeValues}}"
                                                  SelectedItem="{Binding StepType, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="CboStepType"
                                                  AutomationProperties.Name="Step Type">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Common Toggles Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                              Content="Step enabled"
                                              IsChecked="{Binding Enabled}"
                                              Margin="0,0,20,0"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}"
                                              Content="Continue rule pipeline if this step fails"
                                              IsChecked="{Binding ContinueOnError}"
                                              AutomationProperties.AutomationId="ChkContinueOnError"
                                              AutomationProperties.Name="Continue rule pipeline if this step fails"/>
                                </StackPanel>

                                <!-- 1. SmartRename Panel -->
                                <StackPanel Visibility="{Binding IsRenameVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Rename Pattern" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding RenamePattern, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{}{doc_date:yyyy-MM-dd}_{basename}{dotext}"
                                             AutomationProperties.AutomationId="TxtRenamePattern"
                                             AutomationProperties.Name="Rename Pattern"/>

                                    <WrapPanel Margin="0,8,0,8">
                                        <TextBlock Text="Tokens:" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{date:yyyy}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{date:yyyy}" Margin="0,0,5,4" ToolTip="Current year"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{date:MM}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{date:MM}" Margin="0,0,5,4" ToolTip="Current month"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{date:dd}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{date:dd}" Margin="0,0,5,4" ToolTip="Current day"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{ext}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{ext}" Margin="0,0,5,4" ToolTip="Extension without dot"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{basename}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{basename}" Margin="0,0,5,4" ToolTip="Filename without extension"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{doc_date:yyyy-MM-dd}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{doc_date:yyyy-MM-dd}" Margin="0,0,5,4" ToolTip="Extracted document date"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{regex:1}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{regex:1}" Margin="0,0,5,4" ToolTip="Captured regex group"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{var:Name}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{var:Name}" Margin="0,0,5,4" ToolTip="Custom variable"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{counter:001}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{counter:001}" Margin="0,0,5,4" ToolTip="Incrementing counter"/>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Case Transform" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource CaseTransformValues}}"
                                                      SelectedItem="{Binding CaseTransform, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Conflict Policy" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource ConflictResolutionValues}}"
                                                      SelectedItem="{Binding ConflictResolution, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live Output Preview -->
                                    <Border Background="{DynamicResource Brush.AccentSubtle}"
                                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Md}"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="LIVE OUTPUT PREVIEW" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AccentText}"/>
                                            <TextBlock Text="{Binding LivePatternPreview}"
                                                       Style="{StaticResource Text.Mono}"
                                                       Foreground="{DynamicResource Brush.AccentText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 2. Move / Copy Panel -->
                                <StackPanel Visibility="{Binding IsMoveOrCopyVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Destination Folder Template" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding DestinationTemplate, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="{}{directory}\Sorted\{ext}"
                                                 AutomationProperties.AutomationId="TxtDestinationTemplate"
                                                 AutomationProperties.Name="Destination Folder Template"/>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Browse..."
                                                Command="{Binding BrowseDestinationCommand}"
                                                AutomationProperties.Name="Browse Destination Folder"/>
                                    </Grid>

                                    <WrapPanel Margin="0,8,0,8">
                                        <TextBlock Text="Path Tokens:" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{directory}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{directory}" Margin="0,0,5,4" ToolTip="Source watch directory"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{parent}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{parent}" Margin="0,0,5,4" ToolTip="Source parent folder name"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{date:yyyy}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{date:yyyy}" Margin="0,0,5,4" ToolTip="Current year"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{date:MM}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{date:MM}" Margin="0,0,5,4" ToolTip="Current month"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{ext}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{ext}" Margin="0,0,5,4" ToolTip="File extension"/>
                                        <Button Style="{StaticResource TokenChipButtonStyle}" Content="{}{doc_date:yyyy}" Command="{Binding AppendTokenCommand}" CommandParameter="{}{doc_date:yyyy}" Margin="0,0,5,4" ToolTip="Extracted document year"/>
                                    </WrapPanel>

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Conflict Policy" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource ConflictResolutionValues}}"
                                                  SelectedItem="{Binding ConflictResolution, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Live Output Preview -->
                                    <Border Background="{DynamicResource Brush.AccentSubtle}"
                                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Md}"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="LIVE OUTPUT PREVIEW" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AccentText}"/>
                                            <TextBlock Text="{Binding LivePatternPreview}"
                                                       Style="{StaticResource Text.Mono}"
                                                       Foreground="{DynamicResource Brush.AccentText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 3. Extract Archive Panel -->
                                <StackPanel Visibility="{Binding IsArchiveVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Extraction Destination" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource ArchiveDestValues}}"
                                              SelectedItem="{Binding ExtractDestination, Mode=TwoWay}"
                                              Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Visibility="{Binding IsCustomExtractPathVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                        <TextBlock Text="Custom Output Folder" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="{Binding CustomExtractPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="C:\Users\Alex\Downloads\Extracted"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Browse..."
                                                    Command="{Binding BrowseCustomExtractPathCommand}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="Post-Extraction Action" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource ArchivePostActionValues}}"
                                              SelectedItem="{Binding ArchivePostAction, Mode=TwoWay}"
                                              Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Visibility="{Binding IsArchiveMoveTargetVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                        <TextBlock Text="Move Original Archive To" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="{Binding ArchiveMoveTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="{}{directory}\ProcessedArchives"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Browse..."
                                                    Command="{Binding BrowseArchiveMoveTargetCommand}"/>
                                        </Grid>
                                    </StackPanel>

                                    <CheckBox Style="{StaticResource ModernCheckBoxStyle}"
                                              Content="Enqueue extracted files back into the rule pipeline"
                                              IsChecked="{Binding EnqueueExtractedFiles}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 4. Regex Capture Panel -->
                                <StackPanel Visibility="{Binding IsRegexVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Capture Source" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{StaticResource RegexSourceOptions}"
                                              SelectedItem="{Binding RegexSource, Mode=TwoWay}"
                                              Margin="0,0,0,8"/>

                                    <TextBlock Text="Regular Expression Pattern" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="e.g. Invoice\s*#?(?&lt;InvoiceId&gt;[A-Z0-9-]+)"/>
                                    <TextBlock Text="Named groups populate {regex:GroupName}; numbered groups populate {match:1}."
                                               Style="{StaticResource Text.Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 5. Cleanup Folder Panel -->
                                <StackPanel Visibility="{Binding IsCleanupVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Delete Files Older Than (Days)" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding OlderThanDays, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="30"
                                             Margin="0,0,0,8"/>
                                    <CheckBox Style="{StaticResource ModernCheckBoxStyle}"
                                              Content="Send to Windows Recycle Bin safely (undoable)"
                                              IsChecked="{Binding SafeRecycle}"
                                              Margin="0,0,0,6"/>
                                    <CheckBox Style="{StaticResource ModernCheckBoxStyle}"
                                              Content="Remove empty subdirectories"
                                              IsChecked="{Binding RemoveEmptyFolders}"/>
                                </StackPanel>

                                <!-- 6. Run Command Panel -->
                                <StackPanel Visibility="{Binding IsCommandVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Executable or Script Path" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding CommandExecutable, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="C:\Tools\process.ps1"/>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Browse..."
                                                Command="{Binding BrowseCommandExecutableCommand}"/>
                                    </Grid>

                                    <TextBlock Text="Command Arguments" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding CommandArguments, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="&quot;{filepath}&quot; --name &quot;{filename}&quot;"/>
                                    <TextBlock Text="Supported argument placeholders: {filepath}, {filename}, {folder}"
                                               Style="{StaticResource Text.Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 7. Inspect Document / Extract Date Panel -->
                                <Border Visibility="{Binding IsInspectVisible, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource Brush.InfoSubtle}"
                                        BorderBrush="{DynamicResource Brush.Info}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Md}"
                                        Padding="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.FileText}"
                                              Fill="{DynamicResource Brush.InfoText}"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              Margin="0,2,10,0"
                                              VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="Document Inspector"
                                                       Style="{StaticResource Text.CardTitle}"
                                                       Foreground="{DynamicResource Brush.InfoText}"/>
                                            <TextBlock Text="Extracts readable text (PDF, DOCX, TXT, OCR) and detects the document/invoice date so subsequent conditions (ExtractedContent, ExtractedDate) and {doc_date:*} tokens can use them."
                                                       Style="{StaticResource Text.Secondary}"
                                                       Foreground="{DynamicResource Brush.InfoText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 8. Recycle / Permanent Delete Panel -->
                                <Border Visibility="{Binding IsRecycleOrDeleteVisible, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource Brush.WarningSubtle}"
                                        BorderBrush="{DynamicResource Brush.Warning}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Md}"
                                        Padding="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Warning}"
                                              Fill="{DynamicResource Brush.WarningText}"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              Margin="0,2,10,0"
                                              VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="File Removal Step"
                                                       Style="{StaticResource Text.CardTitle}"
                                                       Foreground="{DynamicResource Brush.WarningText}"/>
                                            <TextBlock Text="RecycleFile moves the file to the Windows Recycle Bin where it can be restored. PermanentDelete immediately erases the file from disk and cannot be undone."
                                                       Style="{StaticResource Text.Secondary}"
                                                       Foreground="{DynamicResource Brush.WarningText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER BAR: Inline Rule Tester + Save/Cancel -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Test Draft Rule -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Test Draft:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtTestSampleFile"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="invoice_2026_sample.pdf"
                             Width="270"
                             MinHeight="32"
                             Padding="8,5"
                             Tag="Sample filename or path..."
                             Margin="0,0,6,0"
                             AutomationProperties.AutomationId="TxtTestSampleFile"
                             AutomationProperties.Name="Sample File Path for Draft Rule Test"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Browse..."
                            Click="OnBrowseSampleClick"
                            MinHeight="32"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            AutomationProperties.AutomationId="BtnBrowseSampleFile"
                            AutomationProperties.Name="Browse Sample File"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnTestDraftRuleClick"
                            MinHeight="32"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="BtnTestDraftRule"
                            AutomationProperties.Name="Test Draft Rule">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="11"
                                  Height="11"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Test Rule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Inline Verdict Badge + Output -->
                    <Border x:Name="TestResultBadge"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="9,3"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTestVerdict"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="TxtTestOutput"
                               Style="{StaticResource Text.Mono}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <!-- Right: Cancel & Save -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Content="Cancel"
                            Click="OnCancelClick"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="BtnCancelRule"
                            AutomationProperties.Name="Cancel"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Save Rule"
                            Click="OnSaveClick"
                            AutomationProperties.AutomationId="BtnSaveRule"
                            AutomationProperties.Name="Save Rule"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
