<UserControl x:Class="FileOrgy.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FileOrgy.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="980">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:CountToVisibilityConverter x:Key="CountToZeroVis" ShowWhenZero="True"/>
        <converters:LogLevelToBackgroundConverter x:Key="LogLevelToBackgroundConverter"/>
        <converters:LogLevelToForegroundConverter x:Key="LogLevelToForegroundConverter"/>

        <Style x:Key="DataGridTextElementStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <Style x:Key="LevelPillListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="PillBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                                <Setter TargetName="PillBd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Filter Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Search, Event Filter, Actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="185"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtLogSearch"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Padding="32,7,10,7"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search rule, filename, path, or details..."
                                 AutomationProperties.AutomationId="LogsSearchBox"
                                 AutomationProperties.Name="Search Activity Logs"/>
                        <Path Data="{StaticResource Icon.Search}"
                              Fill="{DynamicResource Brush.TextMuted}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0"
                              IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Event Filter -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding EventFilterOptions}"
                              SelectedItem="{Binding SelectedEventFilter, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LogsEventFilterCombo"
                              AutomationProperties.Name="Filter Logs by Event Type"/>

                    <!-- Export & Clear Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportCsvCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="BtnExportCsv"
                                AutomationProperties.Name="Export Logs to CSV">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Drop}"
                                      Fill="{DynamicResource Brush.TextSecondary}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportJsonCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="BtnExportJson"
                                AutomationProperties.Name="Export Logs to JSON">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.FileText}"
                                      Fill="{DynamicResource Brush.TextSecondary}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Export JSON" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ClearLogsCommand}"
                                AutomationProperties.AutomationId="BtnClearLogs"
                                AutomationProperties.Name="Clear Activity Logs">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Trash}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Clear" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Level Filter Pills & Match Count -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Level:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ListBox ItemsSource="{Binding LevelFilterOptions}"
                                 SelectedItem="{Binding SelectedLevelFilter, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource LevelPillListItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="LogsLevelFilterList"
                                 AutomationProperties.Name="Filter Logs by Level">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"
                               Text="{Binding TotalMatchingCount, StringFormat={}showing up to 300 of {0} matches}"
                               AutomationProperties.AutomationId="LogsMatchingCountText"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Logs DataGrid + Empty State -->
        <Grid Grid.Row="1">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid x:Name="LogsDataGrid"
                          ItemsSource="{Binding Logs}"
                          SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          BorderThickness="0"
                          AutomationProperties.AutomationId="LogsDataGrid"
                          AutomationProperties.Name="Activity History Table">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Source in Explorer" Command="{Binding OpenSourceInExplorerCommand}"/>
                            <MenuItem Header="Open Destination in Explorer" Command="{Binding OpenDestInExplorerCommand}"/>
                            <MenuItem Header="Copy File Path" Command="{Binding CopyPathCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="152"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}"/>
                        <DataGridTemplateColumn Header="Level" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Level, Converter={StaticResource LogLevelToBackgroundConverter}}"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Padding="9,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToForegroundConverter}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Event"
                                            Binding="{Binding EventType}"
                                            Width="135"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}"/>
                        <DataGridTextColumn Header="Rule"
                                            Binding="{Binding RuleName}"
                                            Width="165"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}"/>
                        <DataGridTextColumn Header="Details"
                                            Binding="{Binding Details}"
                                            Width="*"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Crisp Empty State -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding Logs.Count, Converter={StaticResource CountToZeroVis}}">
                <Border Background="{DynamicResource Brush.Well}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Xl}"
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Path Data="{StaticResource Icon.History}"
                          Fill="{DynamicResource Brush.TextMuted}"
                          Width="24"
                          Height="24"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No activity logs match your filters"
                           Style="{StaticResource Text.SectionTitle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Try clearing the search query, switching level filters, or running a folder scan."
                           Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Selected Log Detail Drawer -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,12,0,0"
                Padding="16,14"
                MaxHeight="240"
                Visibility="{Binding SelectedLog, Converter={StaticResource NullToVis}}"
                AutomationProperties.AutomationId="LogDetailDrawer">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding SelectedLog.Level, Converter={StaticResource LogLevelToBackgroundConverter}}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Padding="9,2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedLog.Level}"
                                       Foreground="{Binding SelectedLog.Level, Converter={StaticResource LogLevelToForegroundConverter}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedLog.EventType}"
                                   Style="{StaticResource Text.CardTitle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SelectedLog.RuleName}"
                                   Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SelectedLog.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenSourceInExplorerCommand}"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                MinHeight="30"
                                AutomationProperties.AutomationId="BtnOpenSource"
                                AutomationProperties.Name="Open Source in Explorer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.ExternalLink}"
                                      Fill="{DynamicResource Brush.TextSecondary}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Open Source" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenDestInExplorerCommand}"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                MinHeight="30"
                                AutomationProperties.AutomationId="BtnOpenDestination"
                                AutomationProperties.Name="Open Destination in Explorer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}"
                                      Fill="{DynamicResource Brush.TextSecondary}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Open Destination" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyPathCommand}"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                MinHeight="30"
                                AutomationProperties.AutomationId="BtnCopyPaths"
                                AutomationProperties.Name="Copy Paths">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Copy}"
                                      Fill="{DynamicResource Brush.TextSecondary}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Paths" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="OnCloseDrawerClick"
                                ToolTip="Close detail drawer"
                                AutomationProperties.AutomationId="BtnCloseLogDrawer"
                                AutomationProperties.Name="Close Log Detail Drawer">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11"
                                  Height="11"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Drawer Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Details"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,8,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedLog.Details}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Source"
                                   Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding SelectedLog.SourcePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 CaretBrush="{DynamicResource Brush.TextPrimary}"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12"
                                 Margin="0,0,0,4"
                                 AutomationProperties.AutomationId="LogDrawerSourcePath"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Destination"
                                   Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding SelectedLog.DestinationPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.AccentText}"
                                 CaretBrush="{DynamicResource Brush.TextPrimary}"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12"
                                 AutomationProperties.AutomationId="LogDrawerDestinationPath"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
