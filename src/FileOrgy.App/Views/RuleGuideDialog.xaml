<Window x:Class="FileOrgy.App.Views.RuleGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Automation Rules &amp; Workflows Guide"
        Height="720"
        Width="920"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}">

    <Window.Resources>
        <Style x:Key="GuideSectionCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="GuideCodeBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Brush.Well}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Canvas}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,16">
            <Grid MaxWidth="780" HorizontalAlignment="Center" Width="780">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.AccentSubtle}"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Width="38"
                            Height="38"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource Icon.Lightbulb}"
                              Fill="{DynamicResource Brush.AccentText}"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Automation Rules &amp; Workflows Guide" Style="{StaticResource Text.SectionTitle}" FontSize="18"/>
                        <TextBlock Text="Reference for folder scopes, condition targets, operators, workflow steps, and tokens." Style="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnCloseClick"
                        VerticalAlignment="Center"
                        ToolTip="Close guide"
                        AutomationProperties.AutomationId="BtnGuideHeaderClose"
                        AutomationProperties.Name="Close Guide">
                    <Path Data="{StaticResource Icon.Close}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Centered Scrollable Reading Column -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="0,0,8,0">

                <!-- 1. Rule Evaluation, Priority & Folder Scope -->
                <Border Style="{StaticResource GuideSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Workflow}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="1. Rule Evaluation, Priority &amp; Folder Scope" Style="{StaticResource Text.SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="When a file settles in a monitored watch folder, FileOrgy evaluates enabled rules in ascending Priority order (lowest priority number runs first)."
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Folder Scope" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="Leave all folder pills unselected to run on every monitored folder (e.g. C:\Users\Alex\Downloads). Selecting one or more folder pills restricts the rule to files inside those watch folders and their subdirectories."/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Match Logic" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="Match ALL (AND) requires every condition to pass. Match ANY (OR) triggers if at least one condition passes. A rule with zero conditions matches every file in its folder scope."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stop on Match" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="When enabled, lower-priority rules are skipped once this rule matches and completes. Place specific rules at higher priority and catch-all rules last."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Condition Targets (All 10) -->
                <Border Style="{StaticResource GuideSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Search}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="2. Condition Targets (10 Targets)" Style="{StaticResource Text.SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Each condition inspects one attribute of the incoming file or extracted context:"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="FileName / BaseName" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Full filename with extension (invoice.pdf) or without extension (invoice)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="Extension / FullPath" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Extension without leading dot (pdf, zip) or the full disk path (C:\Users\Alex\Downloads\invoice.pdf)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="FileSizeBytes" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="File size in bytes for numeric comparisons or zero-byte checks."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="FileCreatedDate / Modified" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Filesystem creation timestamp (FileCreatedDate) or last-write timestamp (FileModifiedDate)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="ExtractedContent" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Text content auto-extracted from PDF, DOCX, TXT, or OCR images."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="ExtractedDate" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Document or invoice date detected from extracted text content."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="CustomVariable" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Reads the named variable from TargetVariable (global Variables &amp; Lists or captured pipeline variables)."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Condition Operators (All 15) & Keyword Lists -->
                <Border Style="{StaticResource GuideSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Filter}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="3. Condition Operators (15 Operators) &amp; Keyword Lists" Style="{StaticResource Text.SectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Text &amp; Patterns (8)" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="Equals, NotEquals, Contains, NotContains, StartsWith, EndsWith, MatchesWildcard (* and ?), MatchesRegex (supports CaseSensitive toggle)."/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Keyword Lists (2)" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="InKeywordList and NotInKeywordList match against reusable lists (ArchiveExts, ProgramExts, DocumentExts, PictureExts, VideoExts, AudioExts, AllSortedExts, or your custom lists in Variables &amp; Lists)."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size, Date &amp; Empty (5)" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="GreaterThan, LessThan, OlderThanDays, NewerThanDays, and IsEmptyFile (matches 0-byte files or empty text targets; requires no Value input)."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Workflow Pipeline Steps (All 11) -->
                <Border Style="{StaticResource GuideSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Play}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="4. Sequential Workflow Steps (11 Step Types)" Style="{StaticResource Text.SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Matched rules execute their enabled steps in order from top to bottom. Each step can toggle Continue on Error so downstream steps still run if that step fails."
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="InspectDocument" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Extracts document text, title (doc_title), author (doc_author), and document date for later steps."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="ExtractDate" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Scans document text to detect the billing or invoice date for {doc_date:*} tokens (falls back to creation date)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="RegexCapture" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Runs a regular expression against Content, FileName, or FullPath and stores named or numbered capture groups."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="SmartRename" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Renames the file using template tokens, CaseTransform, and conflict policy (AutoRenameUnique, Overwrite, Skip, KeepNewer)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="MoveFile / CopyFile" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Moves or copies the file to a dynamic destination folder template with conflict resolution."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="ExtractArchive" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Unpacks ZIP, RAR, 7Z, TAR, GZ to SameFolder, SubfolderNamedAfterArchive, or CustomFolder, applies post-action (Keep, Recycle, Delete Permanently, Move), and can enqueue extracted files."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="RecycleFile / PermanentDelete" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="RecycleFile moves to the Windows Recycle Bin (undoable). PermanentDelete immediately removes the file from disk."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="CleanupFolder" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Cleans files older than N days in the file's directory (with SafeRecycle and RemoveEmptyFolders; protected system folders are blocked)."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="RunCommand" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Launches an external script or executable passing argument placeholders like {filepath}, {filename}, and {folder}."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Template Tokens & Case Modifiers -->
                <Border Style="{StaticResource GuideSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Tag}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="5. Template Tokens &amp; Case Modifiers" Style="{StaticResource Text.SectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="{}{directory} / {dir} / {parent}" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Full source folder (e.g. C:\Users\Alex\Downloads) or parent folder name (Downloads)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="{}{filename} / {basename}" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Filename with extension (invoice_may.pdf) or without extension (invoice_may)."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="{}{ext} / {dotext} / {filesize}" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Extension without dot (pdf), with dot (.pdf), formatted size, or {filesize_bytes}."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="{}{date:*} / {doc_date:*}" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Current date ({date:yyyy-MM-dd}), extracted document date ({doc_date:yyyy-MM-dd}), {created:yyyy-MM-dd}, or {modified:yyyy-MM-dd}."/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="{}{regex:name} / {match:1} / {var:*}" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Captured regex groups, custom variables ({var:Vendor}), or padded sequence numbers ({counter:001})."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GuideCodeBadgeStyle}"><TextBlock Text="{}{upper:*} / {snake:*} / {kebab:*}" Style="{StaticResource Text.Mono}"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Inline modifiers: upper:, lower:, title:, snake:, kebab: (e.g. {snake:basename}). SmartRename also offers step-level CaseTransform (None, LowerCase, UpperCase, TitleCase, SnakeCase, KebabCase)."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 6. Example Pipeline -->
                <Border Style="{StaticResource GuideSectionCardStyle}" Margin="0,0,0,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Check}"
                                  Fill="{DynamicResource Brush.SuccessText}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="6. Example: Invoice Auto-Archiving Pipeline" Style="{StaticResource Text.SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Text="Scope: Downloads (C:\Users\Alex\Downloads)  |  Conditions (ALL): Extension Equals pdf + ExtractedContent Contains Invoice"/>
                        <Border Style="{StaticResource WellBorderStyle}" Margin="0,10,0,0" Padding="12">
                            <TextBlock Style="{StaticResource Text.Mono}" TextWrapping="Wrap"
                                       Text="1. InspectDocument&#x0a;2. ExtractDate&#x0a;3. SmartRename -> {doc_date:yyyy-MM-dd}_{basename}{dotext} (SnakeCase)&#x0a;4. MoveFile -> {directory}\Financials\{doc_date:yyyy}"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Grid MaxWidth="780" HorizontalAlignment="Center" Width="780">
                <Button Content="Got it, Close Guide"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnCloseClick"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="BtnGuideFooterClose"
                        AutomationProperties.Name="Close Guide"/>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
