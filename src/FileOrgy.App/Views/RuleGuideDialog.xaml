<Window x:Class="FileOrgy.App.Views.RuleGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Automation Rules &amp; Workflows Guide"
        Height="680" Width="920"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#111827"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CodeBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#374151" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="FileOrgy Automation Rules &amp; Workflows Guide" FontSize="18" FontWeight="SemiBold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Everything you need to know about matching conditions, multi-step actions, and dynamic token formatting." FontSize="12" Foreground="#9CA3AF" Margin="28,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕ Close" Click="OnCloseClick" Padding="12,6" Background="#374151" Foreground="#E5E7EB" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Scrollable Guide Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 1. How Rules Work & Matching Logic -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="1. 🎯 Matching Conditions &amp; Logic" FontSize="15" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,8"/>
                        <TextBlock Text="When a file lands in a monitored folder, FileOrgy evaluates rules from top to bottom by priority." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Match Logic:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="• ALL conditions (AND): File must satisfy every single condition to trigger.&#x0a;• ANY condition (OR): File triggers rule if at least one condition matches." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Targets:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="File Extension (e.g. pdf, zip), File Name with/without extension, Full File Path, File Size in bytes, Creation / Modification Date, or Document Text Content (auto-extracted from PDFs, DOCX, TXT, OCR images)." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Operators:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Equals, Contains, Starts/Ends With, Wildcard (*.log, img_??.*), Regular Expression, Greater/Less Than (for sizes &amp; dates), and Matches Keyword List." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Reusable Keyword Lists -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. 📦 Reusable Keyword Lists &amp; In-Place Sorting" FontSize="15" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,8"/>
                        <TextBlock Text="Instead of creating dozens of separate rules for each file type, keyword lists group hundreds of formats into single powerful conditions:" Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource CodeBadgeStyle}"><TextBlock Text="ArchiveExts" Foreground="#38BDF8" FontFamily="Consolas"/></Border>
                                <TextBlock Text="43 compression formats: .zip, .rar, .7z, .tar, .gz, .bz2, .xz, .iso, .img, .dmg, .wim, .cab, ..." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource CodeBadgeStyle}"><TextBlock Text="ProgramExts" Foreground="#38BDF8" FontFamily="Consolas"/></Border>
                                <TextBlock Text="34 executable formats: .exe, .msi, .msix, .bat, .cmd, .ps1, .vbs, .apk, .appimage, .sh, ..." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource CodeBadgeStyle}"><TextBlock Text="DocumentExts" Foreground="#38BDF8" FontFamily="Consolas"/></Border>
                                <TextBlock Text="75 document &amp; data formats: .pdf, .docx, .xlsx, .pptx, .csv, .txt, .md, .json, .xml, .yaml, ..." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource CodeBadgeStyle}"><TextBlock Text="PictureExts / VideoExts / AudioExts" Foreground="#38BDF8" FontFamily="Consolas"/></Border>
                                <TextBlock Text="Comprehensive media formats (images, RAWs, movies, audio tracks)." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource CodeBadgeStyle}"><TextBlock Text="AllSortedExts" Foreground="#38BDF8" FontFamily="Consolas"/></Border>
                                <TextBlock Text="Dynamic catch-all list. Used by the 'Others' rule: matches any file NOT in the sorted lists!" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="💡 Tip: You can create your own custom keyword lists or edit existing lists under the 'Variables &amp; Lists' tab!" Foreground="#818CF8" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. Multi-Step Execution Pipelines -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. ⚡ Sequential Multi-Step Workflow Actions" FontSize="15" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,8"/>
                        <TextBlock Text="When a rule triggers, its workflow steps run sequentially in order (Step 1 ➔ Step 2 ➔ Step 3). You can reorder steps with ▲ Up / ▼ Down:" Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📁 Move / 📋 Copy File:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Transfers or duplicates file into target destination folder with conflict resolution (auto-rename unique, overwrite, or skip)." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✏️ Smart Rename:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Renames file using pattern tokens e.g. '{doc_date:yyyy-MM-dd}_{basename}.{ext}' with case transforms." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📦 Extract Archive:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Unpacks ZIP, RAR, 7Z, TAR, GZ into a subfolder. Optionally feeds extracted files back into the pipeline." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📅 Extract Document Date:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Scans text content inside invoices/receipts to detect the billing date and saves it for '{doc_date}' tokens." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙️ Run Command:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Executes external batch scripts, PowerShell scripts, or executable tools passing '{filepath}' as an argument." Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Dynamic Tokens Cheatsheet -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="4. 🏷️ Dynamic Path &amp; Rename Tokens Cheatsheet" FontSize="15" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,8"/>
                        <TextBlock Text="Use these tokens in Destination Paths and Smart Rename patterns to dynamically organize files:" Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CodeBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{}{directory} or {dir}" Foreground="#818CF8" FontFamily="Consolas"/></Border>
                            <TextBlock Grid.Column="1" Text="The folder where the file was detected (e.g. C:\Users\swalih\Downloads)." Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CodeBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{}{basename}" Foreground="#818CF8" FontFamily="Consolas"/></Border>
                            <TextBlock Grid.Column="1" Text="Original filename without the extension (e.g. 'Contract_May')." Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CodeBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{}{ext} / {dotext}" Foreground="#818CF8" FontFamily="Consolas"/></Border>
                            <TextBlock Grid.Column="1" Text="File extension without dot ('pdf') or with dot ('.pdf')." Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CodeBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{}{doc_date:yyyy-MM-dd}" Foreground="#818CF8" FontFamily="Consolas"/></Border>
                            <TextBlock Grid.Column="1" Text="Extracted invoice date. Format tokens: yyyy (year), MM (month 01-12), dd (day 01-31)." Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CodeBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{}{year} / {month} / {day}" Foreground="#818CF8" FontFamily="Consolas"/></Border>
                            <TextBlock Grid.Column="1" Text="Current system calendar date when file is organized." Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CodeBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{}{counter:001}" Foreground="#818CF8" FontFamily="Consolas"/></Border>
                            <TextBlock Grid.Column="1" Text="Auto-incrementing numeric counter formatted with leading zeros (001, 002, 003)." Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Real-World Recipe Examples -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="5. 💡 Real-World Examples &amp; Best Practices" FontSize="15" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="• In-Place Subfolder Organization:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock Text="Destination Path: {directory}\Documents&#x0a;Automatically keeps downloads organized right inside your monitored folder under categorized subfolders." Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,8"/>

                        <TextBlock Text="• Invoice Date-based Archiving:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock Text="Step 1: Extract Document Date&#x0a;Step 2: Smart Rename ➔ {doc_date:yyyy-MM-dd}_{basename}.{ext}&#x0a;Step 3: Move File ➔ {directory}\Financials\{doc_date:yyyy}" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,8"/>

                        <TextBlock Text="• Stop on Match:" FontWeight="SemiBold" Foreground="#F9FAFB" FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock Text="When checked, once this rule matches and completes, no lower priority rules will execute on the file. Always keep specific rules (e.g. Invoices) at higher priority and generic catch-alls (e.g. Others) at the lowest priority." Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Got it, Close Guide" Click="OnCloseClick" HorizontalAlignment="Right" Background="#4F46E5" Foreground="White" FontWeight="SemiBold" Padding="20,8" BorderThickness="0" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>
