<UserControl x:Class="FileOrgy.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FileOrgy.App.Converters"
             mc:Ignorable="d"
             x:Name="RulesRoot"
             d:DesignHeight="760" d:DesignWidth="1120">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullInvertedToVis" Invert="True"/>
        <converters:CountToVisibilityConverter x:Key="CountZeroToVis" ShowWhenZero="True"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <converters:EnumFriendlyNameConverter x:Key="EnumFriendlyName"/>
        <converters:StepTypeToIconKeyConverter x:Key="StepTypeToIcon"/>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" MaxWidth="440" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Padding="34,7,10,7"
                             Text="{Binding RulesVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search rules by name or description..."
                             AutomationProperties.AutomationId="Rules_SearchInput"
                             AutomationProperties.Name="Search Rules"/>
                    <Path Data="{StaticResource Icon.Search}"
                          Fill="{DynamicResource Brush.TextMuted}"
                          Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="11,0,0,0"
                          IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnOpenRuleGuideClick"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="Rules_RuleGuideButton"
                            AutomationProperties.Name="Open Rule Guide">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Lightbulb}"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="Rule Guide" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RulesVM.LoadInPlacePresetsCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="Rules_LoadPresetsButton"
                            AutomationProperties.Name="Load In-Place Presets">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Folder}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="Load In-Place Presets" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RulesVM.AddRuleCommand}"
                            AutomationProperties.AutomationId="Rules_NewRuleButton"
                            AutomationProperties.Name="Create New Rule">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Plus}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="New Rule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Split Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Card: Ordered Rule Pipeline List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rule Pipeline Order" Style="{StaticResource Text.SectionTitle}"/>
                            <TextBlock Text="Evaluated top-to-bottom by priority" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                            <TextBlock Text="{Binding RulesVM.FilteredRules.Count}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.AccentText}"/>
                        </Border>
                    </Grid>

                    <!-- Rule Order & Action Toolbar -->
                    <Border Grid.Row="1" Style="{StaticResource WellBorderStyle}" Padding="8,6" Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RulesVM.MoveUpCommand}"
                                    Padding="8,4" MinHeight="28"
                                    Margin="0,0,4,0"
                                    ToolTip="Move selected rule higher in priority"
                                    AutomationProperties.AutomationId="Rules_MoveUpButton"
                                    AutomationProperties.Name="Move Rule Up">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.ChevronUp}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Up" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RulesVM.MoveDownCommand}"
                                    Padding="8,4" MinHeight="28"
                                    Margin="0,0,4,0"
                                    ToolTip="Move selected rule lower in priority"
                                    AutomationProperties.AutomationId="Rules_MoveDownButton"
                                    AutomationProperties.Name="Move Rule Down">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.ChevronDown}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Down" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RulesVM.DuplicateRuleCommand}"
                                    Padding="8,4" MinHeight="28"
                                    Margin="0,0,4,0"
                                    ToolTip="Duplicate selected rule"
                                    AutomationProperties.AutomationId="Rules_ToolbarDuplicateButton"
                                    AutomationProperties.Name="Duplicate Rule">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Duplicate}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Duplicate" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RulesVM.RemoveRuleCommand}"
                                    Padding="8,4" MinHeight="28"
                                    Foreground="{DynamicResource Brush.DangerText}"
                                    ToolTip="Delete selected rule"
                                    AutomationProperties.AutomationId="Rules_DeleteRuleButton"
                                    AutomationProperties.Name="Delete Rule">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Trash}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Delete" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- Rules ListBox -->
                    <ListBox Grid.Row="2"
                             Style="{StaticResource CleanListBoxStyle}"
                             ItemsSource="{Binding RulesVM.FilteredRules}"
                             SelectedItem="{Binding RulesVM.SelectedRule, Mode=TwoWay}"
                             AutomationProperties.AutomationId="Rules_RuleList"
                             AutomationProperties.Name="Automation Rules List">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        AutomationProperties.AutomationId="{Binding Id}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource BadgeBorderStyle}"
                                                VerticalAlignment="Top"
                                                Margin="0,2,10,0">
                                            <TextBlock Text="{Binding Priority, StringFormat=#{0}}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource Text.CardTitle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SummaryText}"
                                                       Style="{StaticResource Text.Muted}"
                                                       FontSize="11.5"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVis}}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2"
                                                  Style="{StaticResource SwitchCheckBoxStyle}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Enable or disable this rule"
                                                  AutomationProperties.AutomationId="Rules_ItemEnabledSwitch"
                                                  AutomationProperties.Name="Enable Rule"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16"
                                Visibility="{Binding RulesVM.FilteredRules.Count, Converter={StaticResource CountZeroToVis}}"
                                AutomationProperties.AutomationId="Rules_EmptyState">
                        <Border Width="44" Height="44"
                                CornerRadius="{StaticResource Radius.Lg}"
                                Background="{DynamicResource Brush.Well}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Path Data="{StaticResource Icon.Workflow}"
                                  Fill="{DynamicResource Brush.TextMuted}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No Matching Rules"
                                   Style="{StaticResource Text.CardTitle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Create a New Rule, load the In-Place Presets, or clear your search filter."
                                   Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Card: Inline Rule Inspector & Dry-Run -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <!-- Empty Selection Placeholder -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="380"
                                Visibility="{Binding RulesVM.SelectedRule, Converter={StaticResource NullInvertedToVis}}"
                                AutomationProperties.AutomationId="Rules_NoSelectionPlaceholder">
                        <Border Width="48" Height="48"
                                CornerRadius="{StaticResource Radius.Lg}"
                                Background="{DynamicResource Brush.Well}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Path Data="{StaticResource Icon.Workflow}"
                                  Fill="{DynamicResource Brush.TextMuted}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Select an Automation Rule"
                                   Style="{StaticResource Text.SectionTitle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Choose a rule on the left to inspect its folder scope, trigger conditions, pipeline steps, and run a safe dry-run simulation."
                                   Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Selected Rule Inspector -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding RulesVM.SelectedRule, Converter={StaticResource NullToVis}}">
                        <StackPanel Margin="0,0,4,0">

                            <!-- Inspector Header -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource BadgeBorderStyle}" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding RulesVM.SelectedRule.Priority, StringFormat=Priority #{0}}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                        </Border>

                                        <Border Background="{DynamicResource Brush.SuccessSubtle}"
                                                BorderBrush="{DynamicResource Brush.Success}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Pill}"
                                                Padding="8,3"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding RulesVM.SelectedRule.Enabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Enabled"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.SuccessText}"/>
                                        </Border>

                                        <Border Background="{DynamicResource Brush.WarningSubtle}"
                                                BorderBrush="{DynamicResource Brush.Warning}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Pill}"
                                                Padding="8,3"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding RulesVM.SelectedRule.Enabled, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="Disabled"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.WarningText}"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding RulesVM.SelectedRule.Name}"
                                               Style="{StaticResource Text.PageTitle}"
                                               FontSize="19"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding RulesVM.SelectedRule.Description}"
                                               Style="{StaticResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding RulesVM.SelectedRule.Description, Converter={StaticResource StringNotEmptyToVis}}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding RulesVM.EditRuleCommand}"
                                            Margin="0,0,8,0"
                                            AutomationProperties.AutomationId="Rules_EditRuleButton"
                                            AutomationProperties.Name="Edit Rule and Steps">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Edit}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/>
                                            <TextBlock Text="Edit Rule &amp; Steps" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RulesVM.DuplicateRuleCommand}"
                                            AutomationProperties.AutomationId="Rules_InspectorDuplicateButton"
                                            AutomationProperties.Name="Duplicate Selected Rule">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Duplicate}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Folder Scope & Execution Behavior Badges -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Background="{DynamicResource Brush.Well}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Padding="10,4"
                                        Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Folder}"
                                              Fill="{DynamicResource Brush.AccentText}"
                                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding RulesVM.SelectedRuleFolderScopeSummary}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Brush.Well}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Padding="10,4"
                                        Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Filter}"
                                              Fill="{DynamicResource Brush.InfoText}"
                                              Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding RulesVM.SelectedRule.Rule.MatchLogic, StringFormat=Match Logic: {0}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Brush.Well}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Padding="10,4"
                                        Margin="0,0,8,6"
                                        Visibility="{Binding RulesVM.SelectedRule.Rule.StopOnFirstMatch, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Stops further rules on match"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>

                                <Border Background="{DynamicResource Brush.Well}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Padding="10,4"
                                        Margin="0,0,8,6"
                                        Visibility="{Binding RulesVM.SelectedRule.Rule.StopOnFirstMatch, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Allows subsequent rules to run"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>
                            </WrapPanel>

                            <!-- Conditions Summary Section -->
                            <Border Style="{StaticResource WellBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Trigger Conditions" Style="{StaticResource Text.CardTitle}"/>
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{Binding RulesVM.SelectedRule.Rule.Conditions.Count}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding RulesVM.SelectedRule.Rule.Conditions}"
                                                  AutomationProperties.AutomationId="Rules_ConditionsSummaryList"
                                                  AutomationProperties.Name="Rule Trigger Conditions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Surface}"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Radius.Md}"
                                                        Padding="10,7"
                                                        Margin="0,0,0,6">
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Target, Converter={StaticResource EnumFriendlyName}}"
                                                                   Style="{StaticResource Text.Body}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"/>

                                                        <Border Background="{DynamicResource Brush.InfoSubtle}"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="6,2"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Operator, Converter={StaticResource EnumFriendlyName}}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource Brush.InfoText}"/>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="7,2"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding Value, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Text="{Binding Value}"
                                                                       Style="{StaticResource Text.Mono}"
                                                                       FontSize="11.5"/>
                                                        </Border>

                                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding KeywordListName, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Text="{Binding KeywordListName, StringFormat=List: {0}}"
                                                                       FontFamily="{StaticResource Font.Mono}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="6,2"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding TargetVariable, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Text="{Binding TargetVariable, StringFormat=Var: {0}}"
                                                                       Style="{StaticResource Text.Mono}"
                                                                       FontSize="11"/>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding CaseSensitive, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Case-sensitive"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No conditions defined — matches every file within the rule's folder scope."
                                               Style="{StaticResource Text.Muted}"
                                               Visibility="{Binding RulesVM.SelectedRule.Rule.Conditions.Count, Converter={StaticResource CountZeroToVis}}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Visual Pipeline Chain -->
                            <Border Style="{StaticResource WellBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Workflow Pipeline Chain" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Steps execute sequentially when the rule conditions match" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{Binding RulesVM.SelectedRulePipelinePreview.Count}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding RulesVM.SelectedRulePipelinePreview}"
                                                  AutomationProperties.AutomationId="Rules_PipelineChainList"
                                                  AutomationProperties.Name="Workflow Pipeline Steps">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Surface}"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Radius.Md}"
                                                        Padding="12,10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="30" Height="30"
                                                                    CornerRadius="{StaticResource Radius.Md}"
                                                                    Background="{DynamicResource Brush.AccentSubtle}"
                                                                    BorderBrush="{DynamicResource Brush.AccentBorder}"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <Path Data="{Binding StepType, Converter={StaticResource StepTypeToIcon}}"
                                                                      Fill="{DynamicResource Brush.AccentText}"
                                                                      Width="14" Height="14" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StepType, Converter={StaticResource EnumFriendlyName}}"
                                                                           Style="{StaticResource Text.CardTitle}"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{StaticResource Text.Muted}"
                                                                           Visibility="{Binding Name, Converter={StaticResource StringNotEmptyToVis}}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                                <Border Background="{DynamicResource Brush.WarningSubtle}"
                                                                        BorderBrush="{DynamicResource Brush.Warning}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{StaticResource Radius.Pill}"
                                                                        Padding="7,2"
                                                                        Margin="6,0,0,0"
                                                                        Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVis}}">
                                                                    <TextBlock Text="Disabled"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Brush.WarningText}"/>
                                                                </Border>

                                                                <Border Background="{DynamicResource Brush.InfoSubtle}"
                                                                        CornerRadius="{StaticResource Radius.Pill}"
                                                                        Padding="7,2"
                                                                        Margin="6,0,0,0"
                                                                        Visibility="{Binding ContinueOnError, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Continue on Error"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Brush.InfoText}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Key Step Parameters in Text.Mono Wells -->
                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="8,5"
                                                                Margin="40,8,0,0"
                                                                Visibility="{Binding RenamePattern, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="Wrap">
                                                                <Run Text="Rename: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                <Run Text="{Binding RenamePattern}"/>
                                                            </TextBlock>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="8,5"
                                                                Margin="40,6,0,0"
                                                                Visibility="{Binding DestinationTemplate, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="Wrap">
                                                                <Run Text="Destination: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                <Run Text="{Binding DestinationTemplate}"/>
                                                            </TextBlock>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="8,5"
                                                                Margin="40,6,0,0"
                                                                Visibility="{Binding RegexPattern, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="Wrap">
                                                                <Run Text="Regex: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                <Run Text="{Binding RegexPattern}"/>
                                                            </TextBlock>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="8,5"
                                                                Margin="40,6,0,0"
                                                                Visibility="{Binding CustomExtractPath, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="Wrap">
                                                                <Run Text="Extract To: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                <Run Text="{Binding CustomExtractPath}"/>
                                                            </TextBlock>
                                                        </Border>

                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="8,5"
                                                                Margin="40,6,0,0"
                                                                Visibility="{Binding CommandExecutable, Converter={StaticResource StringNotEmptyToVis}}">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="Wrap">
                                                                <Run Text="Command: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                <Run Text="{Binding CommandExecutable}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding CommandArguments}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No workflow steps configured yet. Click Edit Rule &amp; Steps to build the pipeline."
                                               Style="{StaticResource Text.Muted}"
                                               Visibility="{Binding RulesVM.SelectedRulePipelinePreview.Count, Converter={StaticResource CountZeroToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Inline Rule Dry-Run Bar -->
                            <Border Style="{StaticResource WellBorderStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Inline Rule Dry-Run" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Test this rule against a sample file path in memory without touching disk."
                                                       Style="{StaticResource Text.Muted}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding PipelinePreviewVM.ClearSimulationCommand}"
                                                Padding="8,4" MinHeight="28"
                                                Content="Clear"
                                                Visibility="{Binding PipelinePreviewVM.HasReport, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.AutomationId="Rules_ClearDryRunButton"
                                                AutomationProperties.Name="Clear Dry-Run Results"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 FontSize="12"
                                                 Text="{Binding PipelinePreviewVM.SampleFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Select or enter a sample file path (e.g. C:\Users\...\invoice.pdf)..."
                                                 KeyDown="OnDryRunPathKeyDown"
                                                 AutomationProperties.AutomationId="Rules_DryRunSamplePathInput"
                                                 AutomationProperties.Name="Sample File Path for Dry-Run"/>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding PipelinePreviewVM.PickSampleFileCommand}"
                                                Content="Browse..."
                                                AutomationProperties.AutomationId="Rules_DryRunBrowseButton"
                                                AutomationProperties.Name="Browse Sample File"/>

                                        <Button Grid.Column="4"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="OnDryRunSelectedRuleClick"
                                                AutomationProperties.AutomationId="Rules_DryRunExecuteButton"
                                                AutomationProperties.Name="Dry-Run This Rule">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Play}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Dry-Run This Rule" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Dry-Run Output Panel -->
                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Md}"
                                            Padding="12"
                                            Visibility="{Binding PipelinePreviewVM.HasReport, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.AutomationId="Rules_DryRunResultsPanel">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                <Ellipse Width="9" Height="9"
                                                         Fill="{Binding PipelinePreviewVM.HasMatch, Converter={StaticResource BoolToStatusBrush}}"
                                                         Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding PipelinePreviewVM.SummaryHeadline}"
                                                           Style="{StaticResource Text.CardTitle}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Before -> After Path Display -->
                                            <Border Background="{DynamicResource Brush.Well}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Sm}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="BEFORE" Style="{StaticResource Text.Caption}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding PipelinePreviewVM.BeforePathDisplay}"
                                                                   Style="{StaticResource Text.Mono}"
                                                                   FontSize="11.5"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <Path Grid.Column="1"
                                                          Data="{StaticResource Icon.ArrowRight}"
                                                          Fill="{DynamicResource Brush.AccentText}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="12,0"/>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="PREDICTED AFTER" Style="{StaticResource Text.Caption}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding PipelinePreviewVM.AfterPathDisplay}"
                                                                   Style="{StaticResource Text.Mono}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource Brush.AccentText}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Simulated Step Results -->
                                            <ItemsControl ItemsSource="{Binding PipelinePreviewVM.MatchedSteps}"
                                                          AutomationProperties.AutomationId="Rules_DryRunMatchedStepsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Brush.Well}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                Padding="8,6"
                                                                Margin="0,4,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Path Grid.Column="0"
                                                                      Data="{Binding StepType, Converter={StaticResource StepTypeToIcon}}"
                                                                      Fill="{DynamicResource Brush.AccentText}"
                                                                      Width="13" Height="13" Stretch="Uniform"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,8,0"/>

                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding StepName}"
                                                                               Style="{StaticResource Text.Body}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12.5"/>
                                                                    <TextBlock Text="{Binding Details}"
                                                                               Style="{StaticResource Text.Muted}"
                                                                               FontSize="11.5"
                                                                               TextWrapping="Wrap"
                                                                               Visibility="{Binding Details, Converter={StaticResource StringNotEmptyToVis}}"/>
                                                                </StackPanel>

                                                                <Ellipse Grid.Column="2"
                                                                         Width="8" Height="8"
                                                                         Fill="{Binding WouldSucceed, Converter={StaticResource BoolToStatusBrush}}"
                                                                         VerticalAlignment="Center"
                                                                         Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
